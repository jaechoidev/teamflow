#!/usr/bin/env bash
# Stub CLI (quota-free): logs invocation + role env, then idles so the pane
# stays alive. Used by tests via PATH injection. STUB_FAIL=1 exits instantly
# (exercises the launcher's instant-failure diagnostics). Emulates codex
# session minting on a fresh boot: an index line plus a rollout whose
# session_meta payload carries id and cwd (the shape verified on local
# codex-cli 0.156.1 data). A `resume` boot reuses the existing entry and
# appends nothing. STUB_FOREIGN_CWD additionally simulates a concurrent
# foreign codex session whose index entry lands after ours (newest) but in a
# different cwd; its id is logged as FOREIGN_ID=.
[ -n "${STUB_FAIL:-}" ] && exit 3
log="${STUB_LOG:?set STUB_LOG}"
{ echo "=== $(basename "$0") $*"
  echo "AGENT_ROLE=$AGENT_ROLE AGENT_ID=$AGENT_ID"
  echo "ROLE_FILE=$AGENT_ROLE_FILE"
  echo "MAILBOX=$AGENT_MAILBOX"
  echo "cwd=$PWD"
} >> "$log"
stub_uuid() {
  printf '%04x%04x-%04x-%04x-%04x-%04x%04x%04x' \
    $RANDOM $RANDOM $RANDOM $RANDOM $RANDOM $RANDOM $RANDOM $RANDOM
}
record_session() { # $1 id $2 cwd
  local d="${CODEX_HOME:-$HOME/.codex}"
  mkdir -p "$d/sessions/stub"
  printf '{"type": "session_meta", "payload": {"id": "%s", "cwd": "%s"}}\n' "$1" "$2" \
    > "$d/sessions/stub/rollout-$1.jsonl"
  printf '{"id": "%s", "thread_name": "stub"}\n' "$1" >> "$d/session_index.jsonl"
}
case " $* " in
  *" resume "*|*"--resume "*) ;;
  *)
    u=$(stub_uuid)
    record_session "$u" "$PWD"
    if [ -n "${STUB_FOREIGN_CWD:-}" ]; then
      f=$(stub_uuid)
      record_session "$f" "$STUB_FOREIGN_CWD"
      echo "FOREIGN_ID=$f" >> "$log"
    fi
    ;;
esac
exec sleep 600
