#!/usr/bin/env bash
# Stub CLI (quota-free): logs invocation + role env, then idles so the pane
# stays alive. Used by tests via PATH injection. --print probes (used by
# scripts/ai-team --check-models) log the routing env, reply ok, and exit.
# Emulates claude transcript storage: --session-id/--resume <id> creates/
# appends ${CLAUDE_CONFIG_DIR:-~/.claude}/projects/stub-project/<id>.jsonl.
log="${STUB_LOG:?set STUB_LOG}"
{
  echo "=== $(basename "$0") $*"
  echo "AGENT_ROLE=$AGENT_ROLE AGENT_ID=$AGENT_ID"
  echo "ROLE_FILE=$AGENT_ROLE_FILE"
  echo "MAILBOX=$AGENT_MAILBOX"
  echo "cwd=$PWD"
  echo "ROUTING BASE_URL=${ANTHROPIC_BASE_URL:-unset} AUTH_TOKEN=${ANTHROPIC_AUTH_TOKEN:+SET} MODEL=${ANTHROPIC_MODEL:-unset}"
  # the final argument on its own, tagged by role: shows whether a startup
  # prompt arrived, and that it arrived as one argument
  echo "LASTARG[$AGENT_ROLE]=${@: -1}"
} >> "$log"
prev=""
sid=""
for a in "$@"; do
  case "$prev" in --session-id|--resume) sid="$a" ;; esac
  prev="$a"
done
if [ -n "$sid" ]; then
  d="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/stub-project"
  mkdir -p "$d"
  : >> "$d/$sid.jsonl"
fi
case " $* " in
  *" --print "*) echo ok; exit 0 ;;
esac
exec sleep 600
