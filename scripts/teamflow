#!/usr/bin/env bash
# teamflow - cross-vendor subagents for any coding agent, in tmux.
#
# Install (once per machine, from a clone of https://github.com/jaechoidev/teamflow):
#   ./install [--dev]             copy this checkout to
#                                 ~/.local/share/teamflow/<version> and link
#                                 ~/.local/bin/teamflow to it. --dev runs the
#                                 checkout itself, for developing teamflow
#   teamflow update               git pull the recorded checkout and reinstall
#   teamflow setup                choose this machine's agent commands per worker
#                                 type. New projects start from that catalog
#   teamflow version | doctor     show the install, or check what teamflow needs
#
# In a project:
#   teamflow                      print this help. It launches nothing.
#   teamflow init                 set the project up: teamflow.conf, stub skills,
#                                 and the AGENTS.md section. Creates a git repo
#                                 and a first commit when needed
#   teamflow start                start the default team, detached
#   teamflow up                   start the default team, or reattach, and attach
#   teamflow types                list the worker types the config offers
#   teamflow add <type-or-id>     add a worker to this session. With no team
#                                 running, it starts one with that worker
#   teamflow remove <id>          remove a worker from this session
#   teamflow list|sync            show the roster, or repair the running windows
#                                 (add, remove, list, and sync are short for
#                                 workers add|remove|list|sync. --save on add or
#                                 remove also updates the default team)
#   teamflow trim                 remove idle workers. When every worker is
#                                 idle, stop the team like --kill
#   teamflow view [<id>...]       gather these workers (default: all running)
#                                 into one tiled window named view. --close
#                                 puts each back in its own window
#   teamflow task|pane ...        the Delegator's mailbox and window commands
#   teamflow guide <skill>|notes  print the full instructions of a skill
#   teamflow role show|edit <role>  print the role in effect, or copy the
#                                 default into the project to customize it
#   teamflow note new <type> <title>  create a project note from its template
#                                 in docs/notes/<type>s/, named by its creation
#                                 time, and print its path
#   teamflow --verify             show worker windows, acknowledgements, the
#                                 Delegator, and the watcher
#   teamflow --check-models       probe configured models (spends a little quota)
#   teamflow --kill               stop the team, then remove stopped workers'
#                                 worktrees whose work is already merged and
#                                 list the rest
#   teamflow worktrees list|merge <id>|discard <id>  merge a stopped worker's
#                                 work into the current branch, or discard its
#                                 worktree, branch, and changes
#
# Flags:
#   --config <file>  use this workspace config instead of teamflow.conf (start, up,
#                    --verify, --check-models, --kill, workers). A relative path
#                    resolves from the repo root, wherever you invoke from.
#                    One team runs per repo: stop the running session with
#                    --kill before starting another config.
#   --no-attach      build detached (up only; start is always detached)
#   --only <worker>  start or up: launch a team with just this worker, given as
#                    an instance ID or a type. The config stays the default team.
#   --last           start or up: bring back the last session's workers
#   --workers        accepted for compatibility. Every team is workers only:
#                    the Delegator runs in your own agent session.
#   -h|--help        show this help
#
# Design notes:
# - The installed tool holds the code, default roles, templates, and full
#   skill text. A project holds only teamflow.conf, stub skills, the AGENTS.md
#   section, and roles it customized. A running team keeps the exact version
#   it started with. API keys never appear here: a provider's key stays in
#   the user's own command (cli = <command>). The deprecated cli = zai
#   sources the env file named in teamflow.conf ([workspace] zai_env).
# - Model availability: binary presence is checked always; whether a MODEL id
#   actually works for your account is only knowable live — use
#   --check-models. Missing configuration is reported, never silently
#   substituted.
# - One team per repo: the mailbox and the role worktrees belong to the repo,
#   not to a config. <mailbox>/active records the running session, the
#   config that started it, and the install that runs it. Another config is
#   refused until --kill.
set -u

# TOOL_HOME is the installed version directory (or the checkout, for a
# development install). ~/.local/bin/teamflow is a link, so follow links
# first, and resolve the `current` link too: a running team keeps the exact
# version it started with even after an update switches `current`.
self_path="${BASH_SOURCE[0]}"
while [ -L "$self_path" ]; do
  self_dir="$(cd "$(dirname "$self_path")" && pwd)"
  self_path="$(readlink "$self_path")"
  case "$self_path" in /*) ;; *) self_path="$self_dir/$self_path" ;; esac
done
TOOL_HOME="$(cd "$(dirname "$self_path")/.." && pwd -P)"
TOOL_LIB="$TOOL_HOME/.agents/lib"
TEAMFLOW_DATA="${XDG_DATA_HOME:-$HOME/.local/share}/teamflow"
MAILBOX_NAME=teamflow # the mailbox lives at <git-common-dir>/teamflow

die() { echo "teamflow: $*" >&2; exit 1; }
say() { echo "teamflow: $*" >&2; }

usage() { # the header comment, up to the design notes
  awk 'NR == 1 { next } /^# Design notes/ { exit } { sub(/^# ?/, ""); print }' "$0"
}

# ---------- helpers ------------------------------------------------------------

shell_quote() { # POSIX single-quote; safe under sh/bash/zsh pane shells
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

hint_path() { # $1 path $2 team root -> the path as a command line takes it
  local c="$1"
  case "$c" in "$2"/*) c="${c#"$2"/}" ;; esac
  case "$c" in *[!A-Za-z0-9_./-]*) c="$(shell_quote "$c")" ;; esac
  printf '%s' "$c"
}

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository; run 'teamflow init' in the target folder first"
}

git_common_dir() { # absolute path to the shared .git dir (works in worktrees)
  git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null \
    || die "cannot resolve git common dir for $1"
}
# Both helpers die on failure, but callers capture them with $(...), which
# runs them in a subshell: a die there exits only the subshell and the empty
# result would flow onward. Every call site therefore ends with `|| exit $?`
# so the diagnostic and nonzero status actually stop the launcher.
# team_root and resolve_conf below follow the same rule.

team_root() { # the checkout that owns the team
  # The team belongs to the repository, so it lives in the main checkout.
  # Invoked from any linked worktree (a worker's .teamflow-worktrees/<id>,
  # or an agent's own worktree), the launcher acts on the main checkout:
  # same session, same mailbox, same config, and the same worktree paths.
  local top main
  top="$(repo_root)" || exit $?
  main="$(git -C "$top" worktree list --porcelain 2>/dev/null \
    | awk 'NR == 1 && sub(/^worktree /, "") { print; exit }')"
  # A bare main repository has no checkout to own the team.
  if [ -n "$main" ] && ! path_eq "$main" "$top" \
     && [ "$(git -C "$main" rev-parse --is-bare-repository 2>/dev/null)" = false ]; then
    top="$main"
  fi
  printf '%s\n' "$top"
}

abs_path() { # canonical path: one file has one name, however it was spelled
  python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$1"
}

conf_hash() {
  python3 -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest())' "$1"
}

resolve_conf() { # $1 team root  $2 --config value ('' = default) -> config path
  local root="$1" arg="$2" p
  command -v python3 >/dev/null 2>&1 || die "python3 not found"
  if [ -z "$arg" ]; then
    p="$root/teamflow.conf"
    [ -f "$p" ] || die "no teamflow.conf in $root. Set this project up with: teamflow init"
  else
    # Relative paths resolve from the repo root, never from the current
    # directory: the same spelling names the same file from a subdirectory
    # or a team worktree.
    case "$arg" in
      /*)    p="$arg" ;;
      "~/"*) p="$HOME/${arg#\~/}" ;;
      *)     p="$root/$arg" ;;
    esac
    if [ ! -f "$p" ]; then
      case "$arg" in
        /*|"~/"*) ;;
        *)
          if [ -f "$PWD/$arg" ]; then
            die "config file not found: $p (relative --config paths resolve from the repo root $root, not from the current directory. Use --config $(hint_path "$(abs_path "$PWD/$arg")" "$root"))"
          fi
          die "config file not found: $p (relative --config paths resolve from the repo root $root)"
          ;;
      esac
      die "config file not found: $p"
    fi
    [ -r "$p" ] || die "config file is not readable: $p"
  fi
  abs_path "$p"
}

# conf_read output field separator is the ASCII unit separator (0x1f), not a
# tab: bash read collapses runs of IFS-whitespace characters (tabs included),
# so an EMPTY field (e.g. [pane.delegator] effort =) would silently shift every
# later field into the wrong variable: effort would read the worktree value.
# 0x1f is not IFS whitespace, so empty fields survive intact.
TSV_SEP=$(printf '\037')

# conf_read <conf-file> -> records on stdout, one per line, 0x1f-separated:
#   workspace line: prefix SEP zai_env
#   one line per pane: id SEP label SEP cli SEP model SEP effort SEP worktree SEP type SEP role_file
conf_read() {
  local root
  root="$(team_root)" || return $?
  python3 "$TOOL_HOME/scripts/teamflow_workers.py" parse "$1" "$root"
}

session_name() { # $1 root, $2 prefix
  local h base
  h=$(printf '%s' "$1" | python3 -c 'import sys,hashlib; print(hashlib.md5(sys.stdin.buffer.read()).hexdigest()[:8])')
  # tmux parses '.' and ':' in targets as window separators — strip them.
  base=$(basename "$1" | tr '.:' '--')
  printf '%s-%s-%s' "$2" "$base" "$h"
}

ensure_exclude() { # $1 common-dir  $2 pattern — keep runtime state out of git status
  local ex="$1/info/exclude"
  touch "$ex"
  grep -qxF "$2" "$ex" 2>/dev/null || echo "$2" >> "$ex"
}

# Routing env vars that must never leak into claude panes: a shell or tmux
# server carrying z.ai proxy routing would silently send native-model panes to
# that endpoint with that token. zai panes re-source their env file right
# after the unset, so clearing is safe for every pane that runs claude.
# Native API-key-env users: put your key in `claude`'s own config, not the
# environment, or extend this list.
CLAUDE_ROUTING_VARS="ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_CUSTOM_HEADERS API_TIMEOUT_MS"

worker_window() { # $1 pane id: a worker's window keeps its ID as its name,
  # stays visible after the CLI exits, and flags new output in the status bar.
  tmux set-window-option -t "$1" remain-on-exit on >/dev/null
  tmux set-window-option -t "$1" automatic-rename off >/dev/null
  tmux set-window-option -t "$1" allow-rename off >/dev/null
  tmux set-window-option -t "$1" monitor-activity on >/dev/null
}

role_path() { # $1 root $2 role file (relative) -> the project's override, else the installed default
  if [ -f "$1/$2" ]; then printf '%s\n' "$1/$2"; else printf '%s\n' "$TOOL_HOME/$2"; fi
}

tool_version() { # the installed version, or the checkout's git description
  if [ -f "$TOOL_HOME/version" ]; then head -1 "$TOOL_HOME/version"
  else git -C "$TOOL_HOME" describe --tags --always --dirty 2>/dev/null || echo unknown; fi
}

note_delegator() { # $1 root: record the calling agent session as the Delegator
  case "${AGENT_ROLE:-}" in ""|delegator) ;; *) return 0 ;; esac
  (cd "$1" && bash "$TOOL_LIB/delegator.sh" register) 2>/dev/null
  return 0
}

start_watcher() { # $1 mailbox $2 root $3 session: one watcher per team (see .agents/lib/watch.sh)
  local mailbox="$1" root="$2" sess="$3" pid watched socket cmd arg
  # A watcher of an earlier session may still be finishing. Only a live
  # watcher of this very session counts.
  read -r pid watched 2>/dev/null < "$mailbox/watcher"
  if [ -n "${pid:-}" ] && [ "${watched:-}" = "$(session_created "$sess")" ] \
     && kill -0 "$pid" 2>/dev/null && ps -o command= -p "$pid" 2>/dev/null | grep -q 'watch\.sh'; then
    return 0
  fi
  socket="$(tmux display-message -p -t "=$sess:" '#{socket_path}')" || return 0
  cmd="bash"
  # TEAMFLOW_WATCH_GRACE, _CAP, _EVERY, _FAST, and _SLOW (seconds) exist for tests only.
  for arg in "$TOOL_LIB/watch.sh" "$socket" "$sess" "$(session_created "$sess")" "$mailbox" \
      "$TOOL_HOME/scripts/teamflow" "$root" "${TEAMFLOW_WATCH_GRACE:-60}" \
      "${TEAMFLOW_WATCH_CAP:-7200}" "${TEAMFLOW_WATCH_EVERY:-60}" \
      "${TEAMFLOW_WATCH_FAST:-600}" "${TEAMFLOW_WATCH_SLOW:-3600}"; do
    cmd="$cmd $(shell_quote "$arg")"
  done
  # run-shell expands #{...} formats, so any # in a path is doubled.
  tmux run-shell -b -t "=$sess:" "${cmd//#/##} >/dev/null 2>&1"
}

write_stop_note() { # $1 mailbox $2 reason: what the next session's list and start show
  local d open=""
  for d in "$1"/tasks/T-*; do
    [ -f "$d/status" ] || continue
    case "$(cat "$d/status")" in
      assigned|in-progress)
        open="$open  ${d##*/}  $(cat "$d/status")  $(sed -n 's/^to:      //p' "$d/task.md" | head -1): $(sed -n 's/^title:   //p' "$d/task.md" | head -1)
" ;;
    esac
  done
  { printf 'The last team stopped at %s, %s.\n' "$(date '+%Y-%m-%d %H:%M')" "$2"
    [ -z "$open" ] || printf 'Unfinished tasks, still in the mailbox:\n%s' "$open"
  } > "$1/stopped"
}

show_stop_note() { # $1 mailbox
  [ -f "$1/stopped" ] && sed 's/^/teamflow: /' "$1/stopped" >&2
  return 0
}

history_source() { # the teamflow checkout whose history identifies files older versions copied
  if git -C "$TOOL_HOME" rev-parse --git-dir >/dev/null 2>&1; then printf '%s\n' "$TOOL_HOME"
  else head -1 "$TEAMFLOW_DATA/source" 2>/dev/null; fi
}

is_tool_source() { # $1 root: the project is teamflow's own checkout
  path_eq "$1" "$TOOL_HOME" || path_eq "$1" "$(head -1 "$TEAMFLOW_DATA/source" 2>/dev/null)"
}

# prepare_project <root>: before a mode acts on a project, move state left
# by older versions (the ai-team names), and point out teamflow files that
# older versions copied into the project. Runs once.
PREPARED=""
prepare_project() {
  local root="$1" common
  [ "$PREPARED" = "$root" ] && return 0
  common="$(git_common_dir "$root")" || exit $?
  python3 "$TOOL_HOME/scripts/teamflow_scaffold.py" migrate "$root" "$common" || exit 1
  if [ -f "$root/scripts/teamflow" ] && ! is_tool_source "$root"; then
    say "this project still has teamflow files that older versions copied in. Remove them with: teamflow init"
  fi
  PREPARED="$root"
}

# ---------- per-role conversation registry ---------------------------------------
# <git-common-dir>/teamflow/sessions/<role>: shell-sourceable KEY=VALUE lines
# (ROLE, CLI, SESSION_ID, CWD, MODEL, STATUS, STARTED_AT, UPDATED_AT, and
# SNAPSHOT for codex discovery). One file per role, written only by the
# launcher. Stores ids and metadata only — never tokens, never transcript
# content.
is_uuid() {
  printf '%s' "$1" | grep -qE '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
}

new_uuid() { python3 -c 'import uuid; print(uuid.uuid4())'; }

now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }

reg_get() { # $1 mailbox $2 role $3 key -> value ('' when absent)
  local f
  f="$1/sessions/$2"
  [ -f "$f" ] || return 0
  grep -E "^$3=" "$f" 2>/dev/null | tail -1 | cut -d= -f2-
}

reg_write() { # $1 mailbox $2 role $3.. KEY=VALUE... (atomic replace)
  local f kv
  f="$1/sessions/$2"
  mkdir -p "${f%/*}"
  for kv in "${@:3}"; do printf '%s\n' "$kv"; done > "$f.tmp" && mv "$f.tmp" "$f"
}

claude_session_exists() { # $1 session id -> transcript still on disk?
  is_uuid "$1" || return 1
  find "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects" -maxdepth 2 -name "$1.jsonl" 2>/dev/null | grep -q .
}

codex_session_exists() { # $1 session id -> known to this codex install?
  is_uuid "$1" || return 1
  local ch="${CODEX_HOME:-$HOME/.codex}"
  grep -q "\"$1\"" "$ch/session_index.jsonl" 2>/dev/null && return 0
  find "$ch/sessions" -name "*$1*" 2>/dev/null | grep -q .
}

path_eq() { # $1 $2 -> same directory (physical-path aware; missing dirs compare literally)
  [ "$1" = "$2" ] && return 0
  local a b
  a="$(cd "$1" 2>/dev/null && pwd -P)" || return 1
  b="$(cd "$2" 2>/dev/null && pwd -P)" || return 1
  [ "$a" = "$b" ]
}

codex_index_ids_since() { # $1 snapshot line count -> minted ids, newest first
  local ch="${CODEX_HOME:-$HOME/.codex}"
  local snap="${1:-0}"
  case "$snap" in *[!0-9]*) snap=0 ;; esac
  tail -n +"$((snap + 1))" "$ch/session_index.jsonl" 2>/dev/null | python3 -c '
import sys, json
ids = []
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        i = json.loads(line).get("id", "")
    except Exception:
        continue
    if i:
        ids.append(i)
for i in reversed(ids):
    print(i)
'
}

codex_rollout_cwd() { # $1 id -> cwd recorded in its rollout session_meta ('' if unknown)
  local ch="${CODEX_HOME:-$HOME/.codex}" f
  f="$(find "$ch/sessions" -name "*$1*" -type f 2>/dev/null | head -1)"
  [ -n "$f" ] || return 0
  python3 -c '
import sys, json
with open(sys.argv[1]) as fh:
    first = fh.readline()
d = json.loads(first)
p = d.get("payload", {}) or {}
print(p.get("cwd", ""))
' "$f" 2>/dev/null
}

codex_new_ids_since() { # $1 snapshot $2 workspace cwd -> newest id bound to that cwd
  local id
  while IFS= read -r id; do
    is_uuid "$id" || continue
    path_eq "$(codex_rollout_cwd "$id")" "$2" || continue
    printf '%s' "$id"
    return 0
  done <<EOF
$(codex_index_ids_since "$1")
EOF
}

reg_follow_cli() { # $1 mailbox $2 role $3 configured cli
  # A conversation id belongs to the CLI that minted it (claude and zai
  # differ too: same binary, another backend). When the configured CLI is
  # not the recorded one, park the entry as sessions/<role>.<cli> and bring
  # back the entry parked for the configured CLI, if there is one. The role
  # then never resumes a foreign id, and it finds its own conversation
  # again when the config switches back.
  local d="$1/sessions" was
  was="$(reg_get "$1" "$2" CLI)"
  [ -n "$was" ] && [ "$was" != "$3" ] || return 0
  mv "$d/$2" "$d/$2.$was"
  if [ -f "$d/$2.$3" ]; then mv "$d/$2.$3" "$d/$2"; fi
}

reg_set_codex_id() { # $1 mailbox $2 role $3 id — record discovered id, mark live
  local m="$1" r="$2"
  reg_write "$m" "$r" \
    "ROLE=$r" "CLI=codex" "SESSION_ID=$3" \
    "CWD=$(reg_get "$m" "$r" CWD)" "MODEL=$(reg_get "$m" "$r" MODEL)" \
    "STATUS=live" "STARTED_AT=$(reg_get "$m" "$r" STARTED_AT)" \
    "UPDATED_AT=$(now_utc)" "SNAPSHOT=$(reg_get "$m" "$r" SNAPSHOT)"
}

# ---------- active team record ---------------------------------------------------
# <mailbox>/active: the tmux session that owns this repo's mailbox right now
# and the config that started it. Same KEY=VALUE shape as the registry
# (SESSION, CREATED, CONFIG, ROOT, STARTED_AT), written only by the launcher
# and read with grep, never sourced. CREATED is the session's tmux creation
# stamp: the record vouches for that one session. When the session is gone,
# or another session took its name, the record is stale and ignored.
team_get() { # $1 mailbox $2 key -> value ('' when absent)
  [ -f "$1/active" ] || return 0
  grep -E "^$2=" "$1/active" 2>/dev/null | tail -1 | cut -d= -f2-
}

team_write() { # $1 mailbox $2.. KEY=VALUE... (atomic replace)
  local f="$1/active" kv
  for kv in "${@:2}"; do printf '%s\n' "$kv"; done > "$f.tmp" && mv "$f.tmp" "$f"
}

session_created() { # $1 session name -> creation stamp ('' when not running)
  tmux list-sessions -F '#{session_created} #{session_name}' 2>/dev/null \
    | awk -v n="$1" '{ c = $1; sub(/^[^ ]+ /, ""); if ($0 == n) { print c; exit } }'
}

default_conf() { # $1 team root -> default config path ('' when there is none)
  local p="$1/teamflow.conf"
  [ -f "$p" ] || return 0
  abs_path "$p"
}

conf_session() { # $1 team root $2 conf -> session name that config yields ('' if unreadable)
  local out
  [ -n "$2" ] || return 0
  out="$(conf_read "$2" 2>/dev/null)" || return 0
  session_name "$1" "$(printf '%s' "$out" | head -1 | cut -d "$TSV_SEP" -f1)"
}

# find_active <mailbox> <default conf> <session name>...
# Sets ACTIVE_SESSION and ACTIVE_CONFIG for the team running in this repo
# (both '' when none runs), ACTIVE_MODE (full or workers), and
# ACTIVE_RECORDED (1 when the launch record vouches for it). A running
# session under one of the given names without a record was started by a
# launcher that wrote none. Such a launcher knew the default config and the
# full team only, so that is what it is attributed to. A record without
# MODE predates workers mode and is a full team too.
find_active() {
  local mailbox="$1" dconf="$2" name created
  ACTIVE_SESSION="" ACTIVE_CONFIG="" ACTIVE_RECORDED=0 ACTIVE_MODE=""
  name="$(team_get "$mailbox" SESSION)"
  if [ -n "$name" ]; then
    created="$(session_created "$name")"
    if [ -n "$created" ] && [ "$created" = "$(team_get "$mailbox" CREATED)" ]; then
      ACTIVE_SESSION="$name"
      ACTIVE_CONFIG="$(team_get "$mailbox" CONFIG)"
      ACTIVE_MODE="$(team_get "$mailbox" MODE)"
      ACTIVE_MODE="${ACTIVE_MODE:-full}"
      ACTIVE_RECORDED=1
      return 0
    fi
  fi
  for name in "${@:3}"; do
    [ -n "$name" ] || continue
    if [ -n "$(session_created "$name")" ]; then
      ACTIVE_SESSION="$name"
      ACTIVE_CONFIG="$dconf"
      ACTIVE_MODE=full
      return 0
    fi
  done
}

hint_mode() { # $1 team mode -> ' --workers' ('' for the full team)
  [ "$1" = workers ] && printf ' --workers'
  return 0
}

mode_tag() { # $1 team mode -> ' (workers only)' ('' for the full team)
  [ "$1" = workers ] && printf ' (workers only)'
  return 0
}

hint_conf() { # $1 conf $2 team root $3 default conf -> ' --config <path>' ('' for the default)
  [ -n "$1" ] && [ "$1" != "$3" ] || return 0
  printf ' --config %s' "$(hint_path "$1" "$2")"
}

# refuse_other_config <mode> <requested conf> <team root> <default conf> [requested team mode]
# The running team was started with another config, or in another team
# mode (full or workers): explain, change nothing.
refuse_other_config() {
  local mode="$1" req="$2" root="$3" dconf="$4" rmode="${5:-}" running what="config"
  if [ "$ACTIVE_MODE" = full ]; then
    say "session $ACTIVE_SESSION is a full team with a Delegator pane, started by an older teamflow. Nothing was changed."
    say "Every team is workers only now. Stop it with: scripts/teamflow --kill"
    exit 1
  fi
  running="${ACTIVE_CONFIG:-unknown}$(mode_tag "$ACTIVE_MODE")"
  [ "$ACTIVE_RECORDED" = 1 ] || running="$running (no launch record: assumed)"
  [ "$ACTIVE_CONFIG" = "$req" ] && what="mode"
  say "session $ACTIVE_SESSION is running with another $what. Nothing was changed."
  say "  running:   $running"
  say "  requested: $req$(mode_tag "$rmode")"
  say "One team runs per repo: the mailbox and the role worktrees are shared. Stop the running session before switching configs or modes."
  case "$mode" in
    up)
      say "  stop it:       scripts/teamflow --kill"
      say "  then start:    scripts/teamflow up$(hint_mode "$rmode")$(hint_conf "$req" "$root" "$dconf")"
      say "  or go back to the running team: scripts/teamflow up$(hint_mode "$ACTIVE_MODE")$(hint_conf "$ACTIVE_CONFIG" "$root" "$dconf")"
      ;;
    *)
      say "  $mode without --config acts on the running team: scripts/teamflow $mode"
      ;;
  esac
  exit 1
}

# follow_team <mode> <team root> <mailbox> <--config value>
# What --verify and --kill act on. Without --config they follow the running
# team, whichever config started it, and fall back to the default config
# when nothing runs. With --config, that config must be the running one.
# Sets ACTIVE_* (find_active), T_CONF ('' = no config file to read), and
# T_NAMED (1 = T_CONF is a config somebody chose: it has to exist and parse).
follow_team() {
  local mode="$1" root="$2" mailbox="$3" arg="$4" dconf req=""
  dconf="$(default_conf "$root")"
  if [ -n "$arg" ]; then
    req="$(resolve_conf "$root" "$arg")" || exit $?
  fi
  find_active "$mailbox" "$dconf" "$(conf_session "$root" "$req")" "$(conf_session "$root" "$dconf")"
  T_NAMED=1
  if [ -n "$req" ]; then
    [ -z "$ACTIVE_SESSION" ] || [ "$ACTIVE_CONFIG" = "$req" ] \
      || refuse_other_config "$mode" "$req" "$root" "$dconf"
    T_CONF="$req"
  elif [ -n "$ACTIVE_SESSION" ] && [ -n "$ACTIVE_CONFIG" ] && [ "$ACTIVE_CONFIG" != "$dconf" ]; then
    T_CONF="$ACTIVE_CONFIG"
  else
    T_CONF="$dconf"
    T_NAMED=0
  fi
}

# ---------- init ---------------------------------------------------------------

cmd_init() {
  local root common stub_paths path bootstrap=0 running
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    root="$(team_root)" || exit $?
  else
    root="$(pwd -P)"
    git init -q -b main "$root" || die "cannot initialize git in $root"
    say "created git repository in $root"
  fi
  git -C "$root" rev-parse --verify HEAD >/dev/null 2>&1 || bootstrap=1
  common="$(git_common_dir "$root")" || exit $?
  python3 "$TOOL_HOME/scripts/teamflow_scaffold.py" migrate "$root" "$common" || exit 1

  # Files older versions copied into the project leave, unless edited. A
  # team started from those copies must stop first: its windows run them.
  if [ -f "$root/scripts/teamflow" ] && ! is_tool_source "$root"; then
    running="$(team_get "$common/$MAILBOX_NAME" SESSION)"
    if [ -n "$running" ] && [ -n "$(session_created "$running")" ] \
       && [ -z "$(team_get "$common/$MAILBOX_NAME" TOOL)" ]; then
      die "session $running runs from teamflow files copied into this project. Stop it with: teamflow --kill, then run teamflow init again"
    fi
    python3 "$TOOL_HOME/scripts/teamflow_scaffold.py" unvendor "$TOOL_HOME" "$(history_source)" "$root" || exit 1
  fi

  local -a scaffold=(teamflow.conf AGENTS.md)
  stub_paths="$(python3 "$TOOL_HOME/scripts/teamflow_scaffold.py" stubs "$TOOL_HOME" "$(history_source)" "$root")" || exit 1
  while IFS= read -r path; do
    [ -n "$path" ] && scaffold+=("$path")
  done <<EOF
$stub_paths
EOF

  python3 "$TOOL_HOME/scripts/teamflow_scaffold.py" drop-pane-delegator "$root/teamflow.conf" || exit 1
  if [ ! -e "$root/teamflow.conf" ]; then
    local catalog="${XDG_CONFIG_HOME:-$HOME/.config}/teamflow/teamflow.conf"
    if [ -f "$catalog" ]; then
      cp "$catalog" "$root/teamflow.conf"
      say "wrote teamflow.conf from your catalog ($catalog), owned by this project"
    else
      cp "$TOOL_HOME/.agents/teamflow.conf" "$root/teamflow.conf"
      say "wrote teamflow.conf from the shipped catalog. Run teamflow setup to choose this machine's commands for new projects"
    fi
  fi
  python3 "$TOOL_HOME/scripts/teamflow_setup.py" offer-zai "$root/teamflow.conf"
  python3 "$TOOL_HOME/scripts/teamflow_scaffold.py" set-version "$root/teamflow.conf" "$(tool_version)" || exit 1

  # AGENTS.md marked section: replace if present, else append; never touch
  # anything outside the markers. Older versions marked it ai-team.
  python3 - "$TOOL_HOME/.agents/AGENTS-SECTION.md" "$root/AGENTS.md" <<'PY'
import sys, os, re
section = open(sys.argv[1]).read()
ag = sys.argv[2]
old = open(ag).read() if os.path.exists(ag) else ""
s = re.sub(r"\n?# >>> (?:teamflow|ai-team) >>>.*?# <<< (?:teamflow|ai-team) <<<\n?", "\n", old, flags=re.S)
s = s.rstrip("\n") + ("\n\n" if s.strip() else "") + section.rstrip("\n") + "\n"
if s != old:
    open(ag, "w").write(s)
PY

  ensure_exclude "$common" ".teamflow-worktrees/"
  PREPARED="$root"

  say "initialized in $root (teamflow $(tool_version) from $TOOL_HOME)"
  if [ "$bootstrap" = 1 ]; then
    git -C "$root" add -- "${scaffold[@]}" \
      || die "could not stage the teamflow files; finish the first commit manually"
    git -C "$root" commit --only -m 'chore: initialize teamflow' -- "${scaffold[@]}" \
      || die "could not commit the teamflow files; finish the first commit manually"
    say "created first commit with the teamflow files only"
  fi
  say "next: open your agent here and use the teamflow skill"
}

# ---------- start --------------------------------------------------------------

cmd_start() { # $1 --config value ('' = default config)  $2 --only value  $3 --last (1|0)
  local root=""
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    root="$(team_root)" || exit $?
  fi
  if [ -z "$root" ] || [ ! -f "$root/teamflow.conf" ] \
     || ! git -C "$root" rev-parse --verify HEAD >/dev/null 2>&1; then
    cmd_init
  fi
  cmd_up 0 "$1" 1 "${2:-}" "${3:-0}"
}

# Shared worker conversation and launch preparation.
pane_cmd() { # role cli model effort cwd rolefile sid mode type flavor launch -> pane shell command
  local prole="$1" pcli="$2" pmodel="$3" peffort="$4" pcwd="$5" pfile="$6" psid="$7" pmode="$8" ptype="$9"
  local pflavor="${10}" plaunch="${11}"
  local envs qfile qmailbox qlib sflag
  qfile="$(shell_quote "$pfile")"
  qmailbox="$(shell_quote "$mailbox")"
  qlib="$(shell_quote "$lib_dir")"
  # export (a shell builtin) rather than the env binary: a deprecated zai
  # worker starts with `.` (source), which env cannot execute.
  envs="export AGENT_ROLE=$(shell_quote "$prole") AGENT_WORKER_TYPE=$(shell_quote "$ptype") AGENT_ID=$(shell_quote "$sess-$prole") \
AGENT_ROLE_FILE=$qfile AGENT_MAILBOX=$qmailbox AGENT_LIB_DIR=$qlib TEAMFLOW_HOME=$(shell_quote "$TOOL_HOME");"
  local args="" run=""
  sflag="--session-id"
  [ "$pmode" = resume ] && sflag="--resume"
  # Workers get no message and idle until addressed. The notetaker checks
  # the note queue after boot, including after a restart. The message is
  # quoted as a whole: it reaches the CLI as one argument whatever the
  # paths contain.
  local hello=""
  if [ "$prole" = notetaker ]; then
    hello=" $(shell_quote "You are the team Notetaker. Read your role file and AGENTS.md, then run: bash $qlib/task.sh ack; bash $qlib/note-queue.sh resume. Reply READY only if no note task is waiting.")"
  fi
  case "$pflavor" in
    codex)
      # Reasoning effort has no --effort flag on codex. It rides as a -c
      # config override. shell_quote keeps the configured value a single
      # safe word. Empty effort means: let codex use its own default.
      local qeff=""
      [ -n "$peffort" ] && qeff="-c model_reasoning_effort=$(shell_quote "$peffort")"
      # Full access mode (user request): no approval prompts, no sandbox.
      if [ "$pmode" = resume ]; then
        # explicit-id resume: flags belong to the resume subcommand
        # (codex-cli 0.156.1 help); never --last/--continue (picker would
        # be cwd-scoped across roles).
        args="resume $(shell_quote "$psid") --dangerously-bypass-approvals-and-sandbox -m $(shell_quote "$pmodel") $qeff -C $(shell_quote "$pcwd")"
      else
        args="--dangerously-bypass-approvals-and-sandbox -m $(shell_quote "$pmodel") $qeff \
$(shell_quote "You are the team $prole. Read $pfile and AGENTS.md in $pcwd. Run: bash $qlib/task.sh ack. $([ "$prole" = notetaker ] && printf 'Then run: bash %s/note-queue.sh resume.' "$qlib") Reply READY only if no task is waiting.")"
      fi
      ;;
    claude|zai)
      args="$sflag $(shell_quote "$psid") --model $(shell_quote "$pmodel")"
      [ -n "$peffort" ] && args="$args --effort $(shell_quote "$peffort")"
      args="$args --append-system-prompt-file $qfile$hello"
      ;;
  esac
  # How the command starts on this machine (teamflow_setup.py resolve): its
  # path, a script copied from an alias or function, or, for one whose copy
  # did not work, the user's interactive shell.
  case "$plaunch" in
    exec:*|script:*) run="$(shell_quote "${plaunch#*:}") $args" ;;
    zai:*) run=". $(shell_quote "$zai_env") && $(shell_quote "${plaunch#zai:}") $args" ;;
    interactive:*) run="exec $(shell_quote "${SHELL:-/bin/sh}") -ic $(shell_quote "${plaunch#interactive:} $args")" ;;
  esac
  # A Claude-flavored command must never inherit another backend's routing.
  # A wrapper sets its own after this.
  [ "$pflavor" = codex ] || run="unset $CLAUDE_ROUTING_VARS; $run"
  printf '%s %s' "$envs" "$run"
}


prepare_worker() {
  # Resume only this instance's recorded conversation. Panes may share a
  # directory, so --continue and --last could select another worker.
  local sid mode status snap="" was_cwd
  reg_follow_cli "$mailbox" "$role" "$cli"
  sid="$(reg_get "$mailbox" "$role" SESSION_ID)"
  was_cwd="$(reg_get "$mailbox" "$role" CWD)"
  case "$flavor" in
    claude|zai)
      # Claude files a transcript under the directory it ran in, so resume
      # only there. A moved worktree starts a new conversation.
      if claude_session_exists "$sid" && { [ -z "$was_cwd" ] || path_eq "$was_cwd" "$cwd"; }; then
        mode=resume
      else mode=fresh; sid="$(new_uuid)"; fi ;;
    codex)
      if codex_session_exists "$sid"; then mode=resume
      else
        mode=fresh; sid=""
        snap="$(wc -l < "${CODEX_HOME:-$HOME/.codex}/session_index.jsonl" 2>/dev/null | tr -d ' ')"
      fi ;;
  esac
  status=live
  [ "$mode" = fresh ] && status=pending
  local -a reg=(ROLE="$role" CLI="$cli" SESSION_ID="$sid" CWD="$cwd" MODEL="$model" \
    STATUS="$status" UPDATED_AT="$(now_utc)")
  [ "$mode" = fresh ] && reg+=(STARTED_AT="$(now_utc)" SNAPSHOT="$snap")
  reg_write "$mailbox" "$role" "${reg[@]}"

  # A role file in the project overrides the installed default.
  local resolved_role_file
  resolved_role_file="$(role_path "$root" "${role_file:-.agents/roles/$role.md}")"
  worker_command="$(pane_cmd "$role" "$cli" "$model" "$effort" "$cwd" "$resolved_role_file" "$sid" "$mode" "$worker_type" "$flavor" "$launch")"
}

# ---------- up -----------------------------------------------------------------

cmd_up() { # $1 attach (1|0)  $2 --config value ('' = default config)  $3 workers only (1|0)  $4 --only value  $5 --last (1|0)
  # $3 (workers only) is kept for callers: every team is workers only.
  local mode_attach="$1" conf_arg="$2" team_mode=workers only="${4:-}" last="${5:-0}"

  command -v tmux >/dev/null 2>&1 || die "tmux not found (brew install tmux / apt install tmux)"
  command -v python3 >/dev/null 2>&1 || die "python3 not found"

  local root conf
  root="$(team_root)" || exit $?
  prepare_project "$root"
  conf="$(resolve_conf "$root" "$conf_arg")" || exit $?

  local confout prefix zai_env_raw
  confout="$(conf_read "$conf")" || die "cannot parse $conf"
  prefix="$(printf '%s' "$confout"   | head -1 | cut -d "$TSV_SEP" -f1)"
  zai_env_raw="$(printf '%s' "$confout" | head -1 | cut -d "$TSV_SEP" -f2)"
  local zai_env="${zai_env_raw/#\~/$HOME}"

  local sess
  sess="$(session_name "$root" "$prefix")"

  # One team per repo: look for a running team before any side effect. The
  # config and mode that started it reattach. Anything else is refused.
  local common mailbox dconf
  common="$(git_common_dir "$root")" || exit $?
  mailbox="$common/$MAILBOX_NAME"
  dconf="$(default_conf "$root")"
  find_active "$mailbox" "$dconf" "$sess" "$(conf_session "$root" "$dconf")"
  if [ -n "$ACTIVE_SESSION" ]; then
    [ "$ACTIVE_CONFIG" = "$conf" ] && [ "$ACTIVE_MODE" = "$team_mode" ] \
      || refuse_other_config up "$conf" "$root" "$dconf" "$team_mode"
    # The running roster may differ from the config: workers added or
    # removed during the session last until --kill. Config edits made
    # while the team runs apply at the next start.
    local saved_hash
    saved_hash="$(team_get "$mailbox" CONFIG_HASH)"
    if [ -n "$saved_hash" ] && [ "$saved_hash" != "$(conf_hash "$conf")" ]; then
      say "$conf changed since $ACTIVE_SESSION started. It applies at the next start (teamflow --kill, then teamflow start)"
    fi
    [ -z "$only" ] || say "a team is already running, so --only $only was ignored. Add workers with: teamflow add <type-or-id>"
    [ "$last" = 0 ] || say "a team is already running, so --last was ignored"
    if [ -f "$mailbox/running.conf" ]; then
      local absent
      absent="$(comm -23 \
        <(printf '%s\n' "$confout" | tail -n +2 | cut -d "$TSV_SEP" -f1 | grep -vx delegator | sort) \
        <(conf_read "$mailbox/running.conf" 2>/dev/null | tail -n +2 | cut -d "$TSV_SEP" -f1 | sort) \
        | paste -sd ' ' -)"
      [ -z "$absent" ] || say "this session runs without these default workers: $absent. Add one with: teamflow workers add <id>"
    fi
    sess="$ACTIVE_SESSION"
    note_delegator "$root"
    start_watcher "$mailbox" "$root" "$sess"
    say "session $sess already running — reattaching (no duplicate launched)"
    [ "$mode_attach" = 1 ] && exec tmux attach-session -t "=$sess"
    echo "$sess"
    return 0
  fi

  # --only keeps a single worker, and --last brings back the last session's
  # workers. The config stays the team's config either way, so the next
  # plain start is the default team.
  local roster="$conf"
  if [ -n "$only" ] || [ "$last" = 1 ]; then
    mkdir -p "$mailbox" || die "cannot create mailbox at $mailbox"
    roster="$mailbox/running.conf.next"
    if [ -n "$only" ]; then
      python3 "$TOOL_HOME/scripts/teamflow_workers.py" only "$conf" "$root" "$only" > "$roster"
    else
      python3 "$TOOL_HOME/scripts/teamflow_workers.py" last "$conf" "$root" > "$roster"
    fi || { rm -f "$roster"; exit 1; }
    confout="$(conf_read "$roster")" || die "cannot parse the session roster"
  fi

  # Copied aliases and functions follow the user's shell. A cheap check:
  # only when the shell startup files changed does it read the definitions.
  python3 "$TOOL_HOME/scripts/teamflow_setup.py" refresh --cheap || true

  # ---- preflight: config + CLIs (fail before creating anything) -------------
  local tsv roles="" missing="" note_tsv="" worker_count
  tsv="$(printf '%s' "$confout" | tail -n +2)"
  note_tsv="$(printf '%s\n' "$tsv" | awk -F "$TSV_SEP" '$1 == "notetaker"')"
  if [ -n "$note_tsv" ]; then
    [ "$(printf '%s\n' "$tsv" | tail -1 | cut -d "$TSV_SEP" -f1)" = notetaker ] \
      || die "Notetaker must be last in $conf"
    [ -f "$TOOL_LIB/note-queue.sh" ] || die "notetaker queue missing from $TOOL_LIB. Reinstall teamflow"
  fi
  worker_count="$(printf '%s\n' "$tsv" | grep -c .)"
  [ "$worker_count" -gt 0 ] \
    || die "$conf has no default team. Add workers on demand with teamflow add <type> (see teamflow types)"

  while IFS="$TSV_SEP" read -r role label cli model effort worktree worker_type role_file flavor launch; do
    if [ -n "$role_file" ]; then
      [ -f "$(role_path "$root" "$role_file")" ] \
        || die "[$role] role file missing: $role_file, in the project or in $TOOL_HOME"
    fi
    roles="$roles $role"
    [ -n "$cli" ] || die "[$role] cli is empty in $conf"
    [ -n "$launch" ] || missing="$missing $cli"
    if [ "$flavor" = zai ]; then
      [ -f "$zai_env" ] || die "[$role] cli=zai but env file not found: $zai_env (set [workspace] zai_env in $conf)"
    fi
    [ -n "$model" ] || die "[$role] model is empty — set it in $conf (no silent defaults)"
  done <<EOF
$tsv
EOF
  [ -z "$missing" ] || die "command(s) not found on this machine:$missing. Install them, or run teamflow setup to register an alias or function"
  # --verify + exit status: plain `rev-parse HEAD` in an unborn repo prints
  # the literal word HEAD (rc 128), which the old -n test mistook for a ref.
  git -C "$root" rev-parse --verify --quiet HEAD >/dev/null 2>&1 \
    || die "repo has no commits yet — make an initial commit first (worktrees need HEAD)"

  # Notes belong to the notetaker: the folder appears when one starts.
  if [ -n "$note_tsv" ]; then
    mkdir -p "$root/docs/notes" || die "cannot create project notes at $root/docs/notes"
  fi

  # Resolve CLIs to absolute paths NOW: pane shells may rewrite PATH
  # (e.g. ~/.zshenv prepending ~/.local/bin), which would otherwise swap the
  # binary under us between launch and boot.

  # ---- workspace: mailbox + worktrees ----------------------------------------
  mkdir -p "$mailbox/tasks" "$mailbox/acks" "$mailbox/sessions" || die "cannot create mailbox at $mailbox"
  ensure_exclude "$common" ".teamflow-worktrees/"

  local role worktree wt_root branch
  wt_root="$root/.teamflow-worktrees"
  while IFS="$TSV_SEP" read -r role label cli model effort worktree worker_type role_file flavor launch; do
    [ "$worktree" = "yes" ] || continue
    branch="teamflow/$role"
    if git -C "$wt_root/$role" rev-parse --git-dir >/dev/null 2>&1; then
      say "worktree exists: $wt_root/$role (reused, untouched)"
      continue
    fi
    if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$root" worktree add "$wt_root/$role" "$branch" >/dev/null \
        || die "cannot add worktree $wt_root/$role on existing branch $branch (left untouched)"
    else
      git -C "$root" worktree add -b "$branch" "$wt_root/$role" >/dev/null \
        || die "cannot create worktree/branch $branch"
    fi
    say "worktree ready: $wt_root/$role (branch $branch)"
  done <<EOF
$tsv
EOF

  # ---- pane command builder ---------------------------------------------------
  local lib_dir="$TOOL_LIB"


  # ---- build the tmux session -------------------------------------------------
  say "building session $sess (one window per worker, named by its ID; CLIs boot in place)"
  local worker_command
  local -a order_roles order_clis order_cmds order_cwds
  local line idx=0
  while IFS="$TSV_SEP" read -r role label cli model effort worktree worker_type role_file flavor launch; do
    order_roles[$idx]="$role"
    order_clis[$idx]="$cli"
    local cwd="$root"
    [ "$worktree" = "yes" ] && cwd="$wt_root/$role"
    order_cwds[$idx]="$cwd"

    prepare_worker
    order_cmds[$idx]="$worker_command"
    idx=$((idx + 1))
  done <<EOF
$tsv
EOF

  boot_fail() {
    tmux kill-session -t "=$sess" 2>/dev/null
    rm -f "$mailbox/active"
    die "$*"
  }
  local pane_total=${#order_cmds[@]} p0 new_pid next_index=1
  # The Notetaker acknowledges again after every launch. Clear the old
  # acknowledgement before its window can start.
  [ -n "$note_tsv" ] && rm -f "$mailbox/acks/notetaker.json"
  # One window per worker, named by its instance ID. Adding or removing a
  # worker opens or closes its window and leaves the others untouched.
  p0="$(tmux new-session -d -P -F '#{pane_id}' -s "$sess" -n "${order_roles[0]}" \
    -c "${order_cwds[0]}" "${order_cmds[0]}")"
  tmux has-session -t "=$sess" 2>/dev/null || \
    die "pane boot failed: '${order_roles[0]}' exited immediately (session rolled back)"
  team_write "$mailbox" "SESSION=$sess" "CREATED=$(session_created "$sess")" \
    "CONFIG=$conf" "CONFIG_HASH=$(conf_hash "$conf")" "ROOT=$root" "STARTED_AT=$(now_utc)" "MODE=$team_mode" \
    "TOOL=$TOOL_HOME" "VERSION=$(tool_version)"
  if [ "$roster" != "$conf" ]; then
    mv "$roster" "$mailbox/running.conf" || boot_fail "cannot save the session roster"
  else
    cp "$conf" "$mailbox/running.conf" || boot_fail "cannot save the session roster"
  fi
  # Clear routing values from this session. Each pane also unsets them
  # before starting a native Claude CLI, while z.ai panes source zai_env.
  local v
  for v in $CLAUDE_ROUTING_VARS; do
    tmux set-environment -u -t "=$sess" "$v" 2>/dev/null
  done
  local -a role_pids=("$p0")
  while [ "$next_index" -lt "$pane_total" ]; do
    new_pid="$(tmux new-window -d -P -F '#{pane_id}' -t "=$sess:" -n "${order_roles[$next_index]}" \
      -c "${order_cwds[$next_index]}" "${order_cmds[$next_index]}")" \
      || boot_fail "could not create a window for ${order_roles[$next_index]}"
    role_pids+=("$new_pid")
    next_index=$((next_index + 1))
  done
  local _pid _i=0
  for _pid in "${role_pids[@]}"; do
    case "$_pid" in
      %*) worker_window "$_pid" ;;
      *) boot_fail "pane boot failed: '${order_roles[$_i]}' exited immediately or its pane id could not be captured" ;;
    esac
    _i=$((_i + 1))
  done

  # codex mints its own session id on first boot: poll the session index and
  # store the minted id only when its rollout session_meta cwd matches this
  # workspace, so a concurrent foreign codex session can never win. If no
  # match appears (slow or old codex, dead pane), the entry stays pending and
  # `--verify` backfills it with the same cwd filter.
  local drole dlabel dcli dmodel deffort dworktree did dtries
  while IFS="$TSV_SEP" read -r drole dlabel dcli dmodel deffort dworktree dtype dfile dflavor dlaunch; do
    if [ "$dflavor" = codex ] && [ "$(reg_get "$mailbox" "$drole" STATUS)" = pending ] \
       && [ -z "$(reg_get "$mailbox" "$drole" SESSION_ID)" ]; then
      did=""
      dtries=0
      while [ "$dtries" -lt 20 ]; do
        did="$(codex_new_ids_since "$(reg_get "$mailbox" "$drole" SNAPSHOT)" "$(reg_get "$mailbox" "$drole" CWD)")"
        [ -n "$did" ] && break
        dtries=$((dtries + 1))
        sleep 0.25
      done
      [ -n "$did" ] && reg_set_codex_id "$mailbox" "$drole" "$did"
    fi
  done <<EOF
$tsv
EOF

  # Labels + pane registry (role -> pane id, used by pane.sh)
  local -a pids=("${role_pids[@]}")
  : > "$mailbox/panes.tsv"
  local i labels
  i=0
  while IFS="$TSV_SEP" read -r role label cli model effort worktree worker_type role_file flavor launch; do
    tmux select-pane -t "${pids[$i]}" -T "$label"
    printf '%s\t%s\n' "$role" "${pids[$i]}" >> "$mailbox/panes.tsv"
    i=$((i + 1))
  done <<EOF
$tsv
EOF

  # The Notetaker can acknowledge before the pane registry is written. Its
  # startup resume leaves the task queued in that case. Poke once now, after
  # registry publication, without duplicating an already active task.
  if [ -n "$note_tsv" ]; then
    AGENT_MAILBOX="$mailbox" bash "$TOOL_LIB/note-queue.sh" poke
  fi

  note_delegator "$root"
  start_watcher "$mailbox" "$root" "$sess"

  say "workspace up: $sess"
  show_stop_note "$mailbox"
  rm -f "$mailbox/stopped"
  say "config: $conf"
  say "one window per worker. Workers idle until addressed. The Delegator runs in your own agent session and reaches the mailbox with: teamflow task|pane ..."
  if [ "$mode_attach" = 1 ]; then
    exec tmux attach-session -t "=$sess"
  fi
  echo "$sess"
}

# ---------- verify / check-models / kill ----------------------------------------

# team_confout <team root>: parsed records of T_CONF (follow_team). The
# default config keeps the lenient fallback it always had here.
team_confout() {
  if [ "$T_NAMED" = 1 ]; then
    [ -f "$T_CONF" ] || die "config file not found: $T_CONF (session $ACTIVE_SESSION was started with it)"
    conf_read "$T_CONF" || die "cannot parse $T_CONF"
  else
    [ -n "$T_CONF" ] || die "no teamflow.conf in $1. Set this project up with: teamflow init"
    conf_read "$T_CONF" || die "cannot parse $T_CONF"
  fi
}

cmd_verify() { # $1 --config value ('' = the running team, else the default config)
  local root confout prefix sess
  root="$(team_root)" || exit $?
  local mailbox; mailbox="$(git_common_dir "$root")/$MAILBOX_NAME" || exit $?
  follow_team --verify "$root" "$mailbox" "$1"
  confout="$(team_confout "$root")" || exit $?
  # A running team reports its session roster, including session-only changes.
  if [ -n "$ACTIVE_SESSION" ] && [ -f "$mailbox/running.conf" ]; then
    confout="$(conf_read "$mailbox/running.conf")" || die "cannot parse $mailbox/running.conf"
  fi
  prefix="$(printf '%s' "$confout" | head -1 | cut -d "$TSV_SEP" -f1)"
  sess="${ACTIVE_SESSION:-$(session_name "$root" "$prefix")}"
  echo "session: $sess ($(tmux has-session -t "=$sess" 2>/dev/null && echo up || echo DOWN))"
  echo "config:  ${T_CONF:-none}"
  show_stop_note "$mailbox"
  if [ -n "$ACTIVE_SESSION" ]; then
    note_delegator "$root"
    local dpid dname dkind dstate wpid
    dpid="$(grep '^PID=' "$mailbox/delegator" 2>/dev/null | cut -d= -f2)"
    dname="$(grep '^NAME=' "$mailbox/delegator" 2>/dev/null | cut -d= -f2-)"
    dkind="$(grep '^KIND=' "$mailbox/delegator" 2>/dev/null | cut -d= -f2)"
    dstate=gone
    (cd "$root" && bash "$TOOL_LIB/delegator.sh" alive) 2>/dev/null && dstate=present
    wpid="$(cut -d' ' -f1 "$mailbox/watcher" 2>/dev/null)"
    if [ "$dkind" = codex ]; then
      echo "delegator: Codex, any Codex session in this project ($dstate)"
    else
      echo "delegator: ${dname:-unknown} (pid ${dpid:-none}, $dstate)"
    fi
    echo "watcher:   $([ -n "$wpid" ] && kill -0 "$wpid" 2>/dev/null && echo "running (pid $wpid)" || echo "not running"). Checks each minute. A minute after the Delegator leaves, idle workers stop, busy ones when done, all within 2 hours (log: .git/teamflow/watch.log)"
  fi
  while IFS="$TSV_SEP" read -r role label cli model effort worktree worker_type role_file flavor launch; do
    local pid ack="no" alive="gone" ack_time="" bid=""
    pid=$(awk -F '\t' -v r="$role" '$1 == r {print $2; exit}' "$mailbox/panes.tsv" 2>/dev/null)
    [ -n "$pid" ] && tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx "$pid" && alive="pane $pid"
    # backfill a codex id that boot-time discovery missed (partial boot);
    # same cwd binding as boot-time discovery, never a foreign session.
    # Not for an external Delegator: the user's own Codex session may run in
    # this directory, and cwd is all discovery goes by.
    if [ "$flavor" = codex ] && [ "$alive" != external ] \
       && [ "$(reg_get "$mailbox" "$role" STATUS)" = pending ] \
       && [ -z "$(reg_get "$mailbox" "$role" SESSION_ID)" ]; then
      bid="$(codex_new_ids_since "$(reg_get "$mailbox" "$role" SNAPSHOT)" "$(reg_get "$mailbox" "$role" CWD)")"
      [ -n "$bid" ] && reg_set_codex_id "$mailbox" "$role" "$bid"
    fi
    if [ -f "$mailbox/acks/$role.json" ]; then
      # ack records are JSON (T-0003 format); fall back to a bare "yes" for
      # missing time fields or unreadable records rather than crashing
      ack_time="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("time",""))' "$mailbox/acks/$role.json" 2>/dev/null)"
      case "$ack_time" in
        ?*) ack="yes ($ack_time)" ;;
        *)  ack="yes" ;;
      esac
    fi
    printf '%-12s %-22s ack=%-28s %s\n' "$role" "$alive" "$ack" "$label"
  done <<EOF
$(printf '%s' "$confout" | tail -n +2)
EOF
  echo "ack=no means the pane has not yet acted on its first message (role file is still pre-loaded via system prompt / startup prompt)."
}

cmd_check_models() { # $1 --config value ('' = default config)
  local root conf confout zai_env_raw zai_env
  root="$(team_root)" || exit $?
  conf="$(resolve_conf "$root" "$1")" || exit $?
  confout="$(conf_read "$conf")" || die "cannot parse $conf"
  zai_env_raw="$(printf '%s' "$confout" | head -1 | cut -d "$TSV_SEP" -f2)"
  zai_env="${zai_env_raw/#\~/$HOME}"
  # cli=zai panes must probe through the configured env file — refuse clearly
  # (same rule as `up`) rather than probing the default endpoint.
  if printf '%s' "$confout" | tail -n +2 | awk -v FS="$TSV_SEP" '$3 == "zai"' | grep -q .; then
    [ -f "$zai_env" ] || die "cli=zai configured but env file not found: $zai_env (set [workspace] zai_env in $conf)"
  fi
  echo "probing models with one tiny request each (costs a little quota)"
  local -a probe_env
  local out
  while IFS="$TSV_SEP" read -r role label cli model effort worktree worker_type role_file flavor launch; do
    probe_env=(env -i HOME="$HOME" PATH="$PATH")
    # STUB_LOG is a test-suite hook (stub CLIs log there); unset in real use.
    [ -n "${STUB_LOG:-}" ] && probe_env+=(STUB_LOG="$STUB_LOG")
    if [ "$flavor" = codex ]; then
      printf '%-12s %-12s %-12s not probed (codex has no cheap model check; models verified at first use)\n' "$role" "$cli" "$model"
      continue
    fi
    # Probe the way a worker starts the command: a clean environment for an
    # executable or a copied script, which sets up its own routing.
    case "$launch" in
      exec:*|script:*) out=$("${probe_env[@]}" "${launch#*:}" --model "$model" --print "reply ok" 2>&1 </dev/null) ;;
      zai:*) out=$("${probe_env[@]}" bash -c '. "$1" && exec "$2" --model "$3" --print "reply ok"' \
               _ "$zai_env" "${launch#zai:}" "$model" 2>&1 </dev/null) ;;
      interactive:*) out=$("${SHELL:-/bin/sh}" -ic "${launch#interactive:} --model $(shell_quote "$model") --print 'reply ok'" 2>&1 </dev/null) ;;
      *) printf '%-12s %-12s %-12s NOT FOUND: run teamflow setup\n' "$role" "$cli" "$model"; continue ;;
    esac
    if [ $? = 0 ] && printf '%s' "$out" | grep -qi ok; then
      printf '%-12s %-12s %-12s OK\n' "$role" "$cli" "$model"
    else
      printf '%-12s %-12s %-12s UNAVAILABLE: %s\n' "$role" "$cli" "$model" \
        "$(printf '%s' "$out" | tail -1 | cut -c1-120)"
    fi
  done <<EOF
$(printf '%s' "$confout" | tail -n +2)
EOF
}

cmd_kill() { # $1 --config value ('' = the running team, else the default config)
  local root confout prefix sess mailbox recorded
  root="$(team_root)" || exit $?
  mailbox="$(git_common_dir "$root")/$MAILBOX_NAME" || exit $?
  follow_team --kill "$root" "$mailbox" "$1"
  sess="$ACTIVE_SESSION"
  if [ -z "$sess" ]; then
    # nothing runs: name the session this config would have started
    confout="$(team_confout "$root")" || exit $?
    prefix="$(printf '%s' "$confout" | head -1 | cut -d "$TSV_SEP" -f1)"
    sess="$(session_name "$root" "$prefix")"
  fi
  tmux kill-session -t "=$sess" 2>/dev/null && say "killed $sess" || say "no session $sess"
  # The watcher stops a team with a reason, for the next session to read.
  [ -z "${TEAMFLOW_STOP_REASON:-}" ] || write_stop_note "$mailbox" "$TEAMFLOW_STOP_REASON"
  # drop the launch record unless its session is, against all odds, still there
  recorded="$(team_get "$mailbox" SESSION)"
  [ -n "$recorded" ] && [ -n "$(session_created "$recorded")" ] || rm -f "$mailbox/active"
  # Stopped workers' worktrees whose work is already merged go away. The
  # rest are listed for a merge or discard decision.
  python3 "$TOOL_HOME/scripts/teamflow_workers.py" worktrees clean "$root"
}

cmd_types() { # $1 --config value: the worker catalog
  local root conf
  root="$(team_root)" || exit $?
  conf="$(resolve_conf "$root" "$1")" || exit $?
  python3 "$TOOL_HOME/scripts/teamflow_workers.py" types "$conf" "$root"
}

cmd_trim() { # $1 --config value: remove idle workers from the running session
  local root rc
  root="$(team_root)" || exit $?
  prepare_project "$root"
  follow_team trim "$root" "$(git_common_dir "$root")/$MAILBOX_NAME" "$1"
  note_delegator "$root"
  [ -n "$ACTIVE_SESSION" ] || die "no team is running, so there are no workers to trim"
  python3 "$TOOL_HOME/scripts/teamflow_workers.py" trim "$T_CONF" "$root"
  rc=$?
  if [ "$rc" = 3 ]; then
    say "every worker is idle, so the team stops"
    cmd_kill "$1"
    return
  fi
  [ "$rc" = 0 ] || exit "$rc"
  python3 "$TOOL_HOME/scripts/teamflow_workers.py" worktrees clean "$root"
}

cmd_view() { # $1 --config value  $2 close (1|0)  $3.. worker IDs
  local root conf_arg="$1" close="$2"
  shift 2
  root="$(team_root)" || exit $?
  follow_team view "$root" "$(git_common_dir "$root")/$MAILBOX_NAME" "$conf_arg"
  note_delegator "$root"
  [ -n "$ACTIVE_SESSION" ] || die "no team is running, so there is nothing to view"
  local -a args=(view "$T_CONF" "$root")
  [ "$close" = 0 ] || args+=(--close)
  python3 "$TOOL_HOME/scripts/teamflow_workers.py" "${args[@]}" "$@"
}

cmd_worktrees() { # $1 action (list|merge|discard) $2 instance id
  local root
  root="$(team_root)" || exit $?
  prepare_project "$root"
  case "${1:-list}" in
    list) python3 "$TOOL_HOME/scripts/teamflow_workers.py" worktrees list "$root" ;;
    *)
      [ -n "$2" ] || die "usage: teamflow worktrees merge <id> | teamflow worktrees discard <id>"
      python3 "$TOOL_HOME/scripts/teamflow_workers.py" worktrees "$1" "$root" "$2"
      ;;
  esac
}

# Launch one worker in an existing team. The Python manager publishes the registry.
cmd_launch_worker() { # config root session worker -> the new window's pane id
  local conf="$1" root="$2" sess="$3" wanted="$4"
  local mailbox lib_dir wt_root zai_env
  mailbox="$(git_common_dir "$root")/$MAILBOX_NAME"
  lib_dir="$TOOL_LIB"
  wt_root="$root/.teamflow-worktrees"
  local confout role label cli model effort worktree worker_type role_file flavor launch cwd worker_command
  confout="$(conf_read "$conf")" || return 1
  zai_env="$(printf '%s' "$confout" | head -1 | cut -d "$TSV_SEP" -f2)"
  zai_env="${zai_env/#\~/$HOME}"
  while IFS="$TSV_SEP" read -r role label cli model effort worktree worker_type role_file flavor launch; do
    [ "$role" = "$wanted" ] || continue
    cwd="$root"
    if [ "$worktree" = yes ]; then
      cwd="$wt_root/$role"
      if ! git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
        if git -C "$root" show-ref --verify --quiet "refs/heads/teamflow/$role"; then
          git -C "$root" worktree add "$cwd" "teamflow/$role" >&2 || return 1
        else
          git -C "$root" worktree add -b "teamflow/$role" "$cwd" >&2 || return 1
        fi
      fi
    fi
    prepare_worker
    local pid
    [ "$role" != notetaker ] || rm -f "$mailbox/acks/notetaker.json"
    pid="$(tmux new-window -d -P -F '#{pane_id}' -t "=$sess:" -n "$role" -c "$cwd" "$worker_command")" || return 1
    worker_window "$pid"
    tmux select-pane -t "$pid" -T "$label"
    printf '%s\n' "$pid"
    return 0
  done < <(printf '%s\n' "$confout" | tail -n +2)
  return 1
}

cmd_workers() { # $1 config argument $2 action $3 value $4 save (1|0)
  local root conf
  root="$(team_root)" || exit $?
  prepare_project "$root"
  follow_team workers "$root" "$(git_common_dir "$root")/$MAILBOX_NAME" "$1"
  conf="$T_CONF"
  note_delegator "$root"
  [ -n "$2" ] || die "usage: teamflow list | add <type-or-id> [--save] | remove <id> [--save] | sync"
  # On demand: with no team running, add starts one with just this worker.
  if [ "$2" = add ] && [ -z "$ACTIVE_SESSION" ] && [ "${4:-0}" = 0 ]; then
    [ -n "$3" ] || die "usage: teamflow add <type-or-id> [--save]"
    say "no team is running, so this starts one with $3"
    cmd_up 0 "$1" 1 "$3"
    return
  fi
  [ "$2" != list ] || show_stop_note "$(git_common_dir "$root")/$MAILBOX_NAME"
  local -a args=("$2" "$conf" "$root")
  [ -z "$3" ] || args+=("$3")
  [ "${4:-0}" = 0 ] || args+=(--save)
  python3 "$TOOL_HOME/scripts/teamflow_workers.py" "${args[@]}"
}

# ---------- install, update, and tool commands -----------------------------------

cmd_install() { # $1 dev (1|0) $2 bin dir
  git -C "$TOOL_HOME" rev-parse --git-dir >/dev/null 2>&1 \
    || die "install runs from a teamflow checkout, and this is an installed copy ($TOOL_HOME). Use teamflow update, or run ./install in a clone of https://github.com/jaechoidev/teamflow"
  python3 "$TOOL_HOME/scripts/teamflow_scaffold.py" install-tool "$TOOL_HOME" "$TEAMFLOW_DATA" "$2" "$1" || exit 1
  offer_path_line "$2"
  local installed="$TEAMFLOW_DATA/current/scripts/teamflow"
  if [ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/teamflow/teamflow.conf" ] && [ -t 0 ] && [ -t 1 ]; then
    bash "$installed" setup || say "setup did not finish. Run teamflow setup any time"
  else
    # Copied aliases and functions may have changed since the last install.
    python3 "$TEAMFLOW_DATA/current/scripts/teamflow_setup.py" refresh || true
  fi
  bash "$installed" doctor || true
}

offer_path_line() { # $1 bin dir: make sure new shells find the teamflow command
  local bin="$1" profile line answer
  case ":$PATH:" in *":$bin:"*) return 0 ;; esac
  case "${SHELL##*/}" in
    zsh) profile="$HOME/.zshrc" ;;
    bash) profile="$HOME/.bashrc" ;;
    *) profile="$HOME/.profile" ;;
  esac
  line="export PATH=\"$bin:\$PATH\"  # teamflow"
  if grep -qxF "$line" "$profile" 2>/dev/null; then
    say "$bin is on PATH in new shells ($profile). Open a new shell, or run: $line"
    return 0
  fi
  if [ -t 0 ] && [ -t 1 ]; then
    printf 'teamflow: %s is not on PATH. Add this line to %s? [y/N] %s\n> ' "$bin" "$profile" "$line"
    read -r answer
    case "$answer" in
      y|Y|yes) printf '\n%s\n' "$line" >> "$profile" && say "added it. Open a new shell to use teamflow" ; return 0 ;;
    esac
  fi
  say "$bin is not on PATH. Add this line to your shell profile: $line"
}

cmd_update() { # pull the recorded checkout and install from it
  local source dev=0
  source="$(head -1 "$TEAMFLOW_DATA/source" 2>/dev/null)"
  [ -n "$source" ] && [ -d "$source" ] || die "no recorded checkout to update from. Run ./install in a clone of https://github.com/jaechoidev/teamflow"
  path_eq "$(cd "$TEAMFLOW_DATA/current" 2>/dev/null && pwd -P)" "$source" && dev=1
  git -C "$source" pull --ff-only || die "git pull failed in $source. Update it by hand, then run: $source/install"
  bash "$source/scripts/teamflow" install $([ "$dev" = 1 ] && echo --dev)
}

cmd_version() {
  echo "teamflow $(tool_version)"
  echo "running from: $TOOL_HOME"
  [ -f "$TEAMFLOW_DATA/source" ] && echo "installed from: $(head -1 "$TEAMFLOW_DATA/source")"
  return 0
}

version_at_least() { # $1 have $2 need (x.y.z, a leading v allowed) -> exit 0 when have >= need
  python3 - "$1" "$2" <<'PY'
import re, sys
def parse(v):
    m = re.match(r"v?(\d+)\.(\d+)\.(\d+)", v)
    return tuple(map(int, m.groups())) if m else None
have, need = parse(sys.argv[1]), parse(sys.argv[2])
sys.exit(0 if have is None or need is None or have >= need else 1)
PY
}

cmd_doctor() {
  local bad=0 v root conf need cli
  ok() { printf '  ok       %s\n' "$*"; }
  miss() { printf '  MISSING  %s\n' "$*"; bad=1; }
  echo "teamflow $(tool_version) at $TOOL_HOME"
  if command -v tmux >/dev/null 2>&1; then
    v="$(tmux -V | sed 's/[^0-9.]//g')"
    version_at_least "$v.0" 3.2.0 && ok "tmux $v" || miss "tmux 3.2 or newer (found $v): brew install tmux / apt install tmux"
  else miss "tmux: brew install tmux / apt install tmux"; fi
  v="$(git --version | awk '{print $3}')"
  version_at_least "$v" 2.31.0 && ok "git $v" || miss "git 2.31 or newer (found $v)"
  v="$(python3 -c 'import sys; print("%d.%d.0" % sys.version_info[:2])' 2>/dev/null)"
  [ -n "$v" ] && version_at_least "$v" 3.8.0 && ok "python3 ${v%.0}" || miss "python3 3.8 or newer"
  if python3 "$TOOL_HOME/scripts/teamflow_setup.py" refresh --report; then
    ok "copied aliases and functions match your shell"
  else
    miss "copied aliases or functions are stale: teamflow update or teamflow setup refreshes them"
  fi
  if command -v teamflow >/dev/null 2>&1; then
    ok "teamflow on PATH: $(command -v teamflow)"
  else
    miss "teamflow on PATH: run ./install in a teamflow checkout, and make sure its bin directory is on PATH"
  fi
  if root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    root="$(team_root)"
    conf="$root/teamflow.conf"
    if [ -f "$conf" ]; then
      ok "project $root"
      need="$(sed -n 's/^teamflow *= *//p' "$conf" | head -1)"
      if [ -n "$need" ]; then
        version_at_least "$(tool_version)" "$need" && ok "project needs teamflow $need" \
          || miss "project needs teamflow $need or later: run teamflow update"
      fi
      local seen="" line_cli line_flavor line_launch
      while IFS="$TSV_SEP" read -r _ _ line_cli _ _ _ _ _ line_flavor line_launch; do
        case " $seen " in *" $line_cli "*) continue ;; esac
        seen="$seen $line_cli"
        if [ -z "$line_launch" ]; then miss "command $line_cli, used by a type in teamflow.conf: install it, or run teamflow setup"
        elif [ "$line_flavor" = zai ]; then ok "zai (deprecated: make a command such as zai-code, run teamflow setup, then set cli = <command>)"
        else ok "command $line_cli ($line_flavor, ${line_launch%%:*})"; fi
      done <<EOF
$(conf_read "$conf" 2>/dev/null | tail -n +2)
EOF
      [ -f "$root/.claude/skills/teamflow/SKILL.md" ] && [ -f "$root/.agents/skills/teamflow/SKILL.md" ] \
        && ok "this project's stub skills in $root/.claude/skills and .agents/skills (never user-level)" \
        || miss "this project's stub skills: run teamflow init"
      [ ! -f "$root/scripts/teamflow" ] || is_tool_source "$root" \
        || miss "no copied teamflow files: this project still has them. Run teamflow init"
    else
      echo "  (not a teamflow project: run teamflow init here to set it up)"
    fi
  fi
  return "$bad"
}

cmd_guide() { # $1 skill name or notes: print its full instructions
  local name="${1:-}" file
  case "$name" in
    "") echo "usage: teamflow guide <skill> | notes"; ls "$TOOL_HOME/skills" | sed 's/^/  /'; echo "  notes"; return 0 ;;
    notes) file="$TOOL_HOME/.agents/doc-templates/README.md" ;;
    *) file="$TOOL_HOME/skills/$name/SKILL.md" ;;
  esac
  [ -f "$file" ] || die "no guide named $name. See: teamflow guide"
  # Print the instructions without the skill's frontmatter.
  awk 'NR == 1 && /^---$/ { front = 1; next } front && /^---$/ { front = 0; next } !front' "$file"
}

cmd_role() { # role show|edit <name>: print the role in effect, or copy the default in to edit
  local action="${1:-}" name="${2:-}" root rel
  case "$action" in show|edit) ;; *) name="" ;; esac
  [ -n "$name" ] || die "usage: teamflow role show|edit <role>  (roles: $(ls "$TOOL_HOME/.agents/roles" | sed 's/\.md$//' | paste -sd ' ' -))"
  root="$(team_root)" || exit $?
  rel=".agents/roles/$name.md"
  if [ "$action" = show ]; then
    [ -f "$(role_path "$root" "$rel")" ] || die "no role named $name"
    cat "$(role_path "$root" "$rel")"
    return 0
  fi
  [ -f "$TOOL_HOME/$rel" ] || die "no role named $name in $TOOL_HOME/.agents/roles"
  if [ -f "$root/$rel" ]; then
    say "$rel already exists in this project. Edit it there"
  else
    mkdir -p "$root/.agents/roles" && cp "$TOOL_HOME/$rel" "$root/$rel"
    say "copied the default $name role to $rel. Edit it there: it overrides the installed default for new windows"
  fi
}

cmd_note() { # note new <type> <title>: create a project note and print its path
  local root types
  types="$(ls "$TOOL_HOME/.agents/doc-templates" | grep -v '^README' | sed 's/\.md$//' | paste -sd ' ' -)"
  [ "${1:-}" = new ] && [ $# -eq 3 ] || die "usage: teamflow note new <type> \"<title>\"  (types: $types)"
  root="$(team_root)" || exit $?
  python3 "$TOOL_HOME/scripts/teamflow_scaffold.py" note-new "$TOOL_HOME" "$root" "$2" "$3"
}

# ---------- main -----------------------------------------------------------------

# Mode and flags may come in any order. Everything is parsed and checked
# before any mode runs, so a mistyped command line has no side effects.
if [ "${1:-}" = --internal-launch-worker ]; then
  shift
  cmd_launch_worker "$@"
  exit $?
fi
# These take their own arguments, passed through untouched.
case "${1:-}" in
  task|pane) tool="$1"; shift; exec bash "$TOOL_LIB/delegator.sh" "$tool" "$@" ;;
  guide) shift; cmd_guide "$@"; exit $? ;;
  setup) shift; exec python3 "$TOOL_HOME/scripts/teamflow_setup.py" setup "$@" ;;
  role) shift; cmd_role "$@"; exit $? ;;
  note) shift; cmd_note "$@"; exit $? ;;
  version|--version) cmd_version; exit 0 ;;
  doctor) cmd_doctor; exit $? ;;
  update) cmd_update; exit $? ;;
  install)
    shift
    dev=0 bin_dir="$HOME/.local/bin"
    while [ $# -gt 0 ]; do
      case "$1" in
        --dev) dev=1 ;;
        --bin-dir) [ $# -ge 2 ] || die "--bin-dir requires a directory"; shift; bin_dir="$1" ;;
        --bin-dir=*) bin_dir="${1#--bin-dir=}" ;;
        *) die "usage: teamflow install [--dev] [--bin-dir <dir>]" ;;
      esac
      shift
    done
    cmd_install "$dev" "$bin_dir"; exit $? ;;
esac

MODE="" NO_ATTACH=0 CONFIG="" CONFIG_GIVEN=0 WORKERS=0 WORKER_ACTION="" WORKER_VALUE="" SAVE=0 ONLY="" LAST=0 CLOSE=0
VIEW_IDS=()

pick_mode() {
  [ -z "$MODE" ] || [ "$MODE" = "$1" ] || die "choose one mode: '$MODE' and '$1' cannot be combined"
  MODE="$1"
}

while [ $# -gt 0 ]; do
  case "$1" in
    init|start|up|--verify|--check-models|--kill|workers|worktrees|types|trim|view) pick_mode "$1" ;;
    list|add|remove|sync|merge|discard)
      # teamflow add|remove|list|sync is short for teamflow workers ...
      if [ -z "$MODE" ]; then
        case "$1" in add|remove|list|sync) MODE=workers ;; esac
      fi
      case "$MODE:$1" in
        workers:list|workers:add|workers:remove|workers:sync) ;;
        worktrees:list|worktrees:merge|worktrees:discard) ;;
        *) die "unknown argument: $1" ;;
      esac
      [ -z "$WORKER_ACTION" ] || die "unknown argument: $1"
      WORKER_ACTION="$1" ;;
    --no-attach) NO_ATTACH=1 ;;
    --workers) WORKERS=1 ;;
    --save) SAVE=1 ;;
    --last) LAST=1 ;;
    --close) CLOSE=1 ;;
    --only|--only=*)
      [ -z "$ONLY" ] || die "--only given more than once"
      if [ "$1" = --only ]; then
        [ $# -ge 2 ] || die "--only requires a worker type or instance ID (e.g. --only notetaker)"
        shift
        ONLY="$1"
      else
        ONLY="${1#--only=}"
      fi
      case "$ONLY" in ""|-*) die "--only requires a worker type or instance ID, got '$ONLY'" ;; esac
      ;;
    --config|--config=*)
      [ "$CONFIG_GIVEN" = 0 ] || die "--config given more than once"
      if [ "$1" = "--config" ]; then
        [ $# -ge 2 ] || die "--config requires a file path (e.g. --config teamflow.claude.conf)"
        shift
        CONFIG="$1"
      else
        CONFIG="${1#--config=}"
      fi
      case "$CONFIG" in
        ""|-*) die "--config requires a file path, got '$CONFIG' (e.g. --config teamflow.claude.conf)" ;;
      esac
      CONFIG_GIVEN=1
      ;;
    -h|--help) usage; exit 0 ;;
    *)
      if [ "$MODE" = view ]; then
        VIEW_IDS+=("$1")
      elif [ -z "$WORKER_VALUE" ] && case "$MODE:$WORKER_ACTION" in
           workers:add|workers:remove|worktrees:merge|worktrees:discard) true ;; *) false ;; esac; then
        WORKER_VALUE="$1"
      else
        usage; die "unknown argument: $1"
      fi ;;
  esac
  shift
done

# A bare teamflow launches nothing: new projects run init, then an agent's
# teamflow skill starts the workers.
if [ -z "$MODE" ]; then
  usage
  [ "$NO_ATTACH$WORKERS$CONFIG_GIVEN$SAVE$LAST$CLOSE" = 000000 ] && [ -z "$ONLY" ] || die "choose a mode, e.g. start or up"
  exit 0
fi
[ "$NO_ATTACH" = 0 ] || [ "$MODE" = up ] || [ "$MODE" = start ] \
  || die "--no-attach applies to start or up only, not to $MODE"
[ "$WORKERS" = 0 ] || [ "$MODE" = up ] || [ "$MODE" = start ] \
  || die "--workers applies to start or up only, not to $MODE (--verify and --kill follow the running team)"
[ -z "$ONLY" ] || [ "$MODE" = up ] || [ "$MODE" = start ] \
  || die "--only applies to start or up only"
[ "$LAST" = 0 ] || [ "$MODE" = up ] || [ "$MODE" = start ] \
  || die "--last applies to start or up only"
[ "$CLOSE" = 0 ] || [ "$MODE" = view ] || die "--close applies to view only"
[ -z "$ONLY" ] || [ "$LAST" = 0 ] || die "choose --only or --last, not both"
[ "$SAVE" = 0 ] || { [ "$MODE" = workers ] && { [ "$WORKER_ACTION" = add ] || [ "$WORKER_ACTION" = remove ]; }; } \
  || die "--save applies to workers add or workers remove only"
[ "$CONFIG_GIVEN" = 0 ] || [ "$MODE" != worktrees ] \
  || die "--config does not apply to worktrees, which read no config"
[ "$CONFIG_GIVEN" = 0 ] || [ "$MODE" != init ] \
  || die "--config does not apply to init, which reads no config. Pass it to start, up, --verify, --check-models, or --kill"

case "$MODE" in
  init)           cmd_init ;;
  start)          cmd_start "$CONFIG" "$ONLY" "$LAST" ;;
  up)             cmd_up "$((1 - NO_ATTACH))" "$CONFIG" "$WORKERS" "$ONLY" "$LAST" ;;
  --verify)       cmd_verify "$CONFIG" ;;
  --check-models) cmd_check_models "$CONFIG" ;;
  --kill)         cmd_kill "$CONFIG" ;;
  workers)        cmd_workers "$CONFIG" "$WORKER_ACTION" "$WORKER_VALUE" "$SAVE" ;;
  worktrees)      cmd_worktrees "$WORKER_ACTION" "$WORKER_VALUE" ;;
  types)          cmd_types "$CONFIG" ;;
  trim)           cmd_trim "$CONFIG" ;;
  view)           cmd_view "$CONFIG" "$CLOSE" ${VIEW_IDS[@]+"${VIEW_IDS[@]}"} ;;
esac
