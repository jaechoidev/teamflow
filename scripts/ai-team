#!/usr/bin/env bash
# ai-team — portable six-agent tmux workspace launcher.
#
# Modes:
#   scripts/ai-team init          scaffold this tool into the current git repo
#                                 (.agents/, ai-team.conf if absent, AGENTS.md
#                                 marked section, ./scripts/ai-team copy)
#   scripts/ai-team up            launch (resumes role conversations) or reattach
#   scripts/ai-team --verify      show pane liveness + role acknowledgements
#   scripts/ai-team --check-models  probe configured models (spends a little
#                                 quota; clean env, zai panes source zai_env)
#   scripts/ai-team --kill        kill the workspace session
#
# Flags:
#   --config <file>  use this workspace config instead of ai-team.conf (up,
#                    --verify, --check-models, --kill). A relative path
#                    resolves from the repo root, wherever you invoke from.
#                    One team runs per repo: stop the running session with
#                    --kill before starting another config.
#   --no-attach      build detached (up only)
#   --workers        up only: start the five workers in one column and no
#                    Delegator pane. The Delegator runs in your own terminal
#                    and reaches the mailbox through .agents/lib/delegator.sh.
#                    [pane.delegator] is ignored and may be absent.
#   -h|--help        show this help
#
# Design notes:
# - Everything is derived from the CURRENT repo (git rev-parse); no
#   user-specific absolute paths are embedded. API keys never appear here:
#   z.ai panes source the env file named in ai-team.conf ([workspace] zai_env).
# - Model availability: binary presence is checked always; whether a MODEL id
#   actually works for your account is only knowable live — use
#   --check-models. Missing configuration is reported, never silently
#   substituted.
# - One team per repo: the mailbox and the role worktrees belong to the repo,
#   not to a config. <mailbox>/active records the running session, the
#   config that started it, and its mode (full or workers). Another config
#   or mode is refused until --kill.
set -u

TOOL_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

die() { echo "ai-team: $*" >&2; exit 1; }
say() { echo "ai-team: $*" >&2; }

usage() { # the header comment, up to the design notes
  awk 'NR == 1 { next } /^# Design notes/ { exit } { sub(/^# ?/, ""); print }' "$0"
}

# ---------- helpers ------------------------------------------------------------

shell_quote() { # POSIX single-quote; safe under sh/bash/zsh pane shells
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

hint_path() { # $1 path $2 team root -> the path as a command line takes it
  local c="$1"
  case "$c" in "$2"/*) c="${c#"$2"/}" ;; esac
  case "$c" in *[!A-Za-z0-9_./-]*) c="$(shell_quote "$c")" ;; esac
  printf '%s' "$c"
}

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository — cd into the target project (or run 'ai-team init' here after git init)"
}

git_common_dir() { # absolute path to the shared .git dir (works in worktrees)
  git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null \
    || die "cannot resolve git common dir for $1"
}
# Both helpers die on failure, but callers capture them with $(...), which
# runs them in a subshell: a die there exits only the subshell and the empty
# result would flow onward. Every call site therefore ends with `|| exit $?`
# so the diagnostic and nonzero status actually stop the launcher.
# team_root and resolve_conf below follow the same rule.

team_root() { # the checkout that owns the team
  # Team worktrees live at <root>/.ai-team-worktrees/<name>. Invoked from
  # one, the launcher acts on <root>: same session, same mailbox, and the
  # same config paths as from the checkout itself.
  local top parent owner
  top="$(repo_root)" || exit $?
  parent="$(dirname "$top")"
  if [ "$(basename "$parent")" = ".ai-team-worktrees" ]; then
    owner="$(dirname "$parent")"
    if [ "$(git -C "$owner" rev-parse --show-toplevel 2>/dev/null)" = "$owner" ] \
       && [ "$(git -C "$owner" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
            = "$(git -C "$top" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ]; then
      top="$owner"
    fi
  fi
  printf '%s\n' "$top"
}

abs_path() { # canonical path: one file has one name, however it was spelled
  python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$1"
}

resolve_conf() { # $1 team root  $2 --config value ('' = default) -> config path
  local root="$1" arg="$2" p
  command -v python3 >/dev/null 2>&1 || die "python3 not found"
  if [ -z "$arg" ]; then
    p="$root/ai-team.conf"
    [ -f "$p" ] || p="$TOOL_HOME/ai-team.conf"
    [ -f "$p" ] || die "no ai-team.conf (run: scripts/ai-team init)"
  else
    # Relative paths resolve from the repo root, never from the current
    # directory: the same spelling names the same file from a subdirectory
    # or a team worktree.
    case "$arg" in
      /*)    p="$arg" ;;
      "~/"*) p="$HOME/${arg#\~/}" ;;
      *)     p="$root/$arg" ;;
    esac
    if [ ! -f "$p" ]; then
      case "$arg" in
        /*|"~/"*) ;;
        *)
          if [ -f "$PWD/$arg" ]; then
            die "config file not found: $p (relative --config paths resolve from the repo root $root, not from the current directory. Use --config $(hint_path "$(abs_path "$PWD/$arg")" "$root"))"
          fi
          die "config file not found: $p (relative --config paths resolve from the repo root $root)"
          ;;
      esac
      die "config file not found: $p"
    fi
    [ -r "$p" ] || die "config file is not readable: $p"
  fi
  abs_path "$p"
}

# conf_read output field separator is the ASCII unit separator (0x1f), not a
# tab: bash read collapses runs of IFS-whitespace characters (tabs included),
# so an EMPTY field (e.g. [pane.delegator] effort =) would silently shift every
# later field into the wrong variable: effort would read the worktree value.
# 0x1f is not IFS whitespace, so empty fields survive intact.
TSV_SEP=$(printf '\037')

# conf_read <conf-file> -> records on stdout, one per line, 0x1f-separated:
#   workspace line: prefix SEP zai_env SEP ttl
#   one line per pane (in order): role SEP label SEP cli SEP model SEP effort SEP worktree
conf_read() {
  python3 - "$1" <<'PY'
import sys, configparser, os
SEP = "\x1f"
cp = configparser.ConfigParser()
cp.read(sys.argv[1])
w = cp["workspace"] if cp.has_section("workspace") else {}
prefix = w.get("session_prefix", "at")
zai_env = w.get("zai_env", "~/.zai/env.sh")
ttl = w.get("task_ttl_days", "7")
print(SEP.join([prefix, zai_env, ttl]))
for sec in cp.sections():
    if not sec.startswith("pane."):
        continue
    role = sec[len("pane."):]
    p = cp[sec]
    print(SEP.join([
        role,
        p.get("label", role),
        p.get("cli", ""),
        p.get("model", ""),
        p.get("effort", ""),
        p.get("worktree", "no"),
    ]))
PY
}

session_name() { # $1 root, $2 prefix
  local h base
  h=$(printf '%s' "$1" | python3 -c 'import sys,hashlib; print(hashlib.md5(sys.stdin.buffer.read()).hexdigest()[:8])')
  # tmux parses '.' and ':' in targets as window separators — strip them.
  base=$(basename "$1" | tr '.:' '--')
  printf '%s-%s-%s' "$2" "$base" "$h"
}

ensure_exclude() { # $1 common-dir  $2 pattern — keep runtime state out of git status
  local ex="$1/info/exclude"
  touch "$ex"
  grep -qxF "$2" "$ex" 2>/dev/null || echo "$2" >> "$ex"
}

# Routing env vars that must never leak into claude panes: a shell or tmux
# server carrying z.ai proxy routing would silently send native-model panes to
# that endpoint with that token. zai panes re-source their env file right
# after the unset, so clearing is safe for every pane that runs claude.
# Native API-key-env users: put your key in `claude`'s own config, not the
# environment, or extend this list.
CLAUDE_ROUTING_VARS="ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_CUSTOM_HEADERS API_TIMEOUT_MS"

install_file() { # $1 src $2 dst — user-edited files win; shipped copy staged as <dst>.new
  if [ ! -e "$2" ]; then
    cp "$1" "$2"
  elif ! cmp -s "$1" "$2"; then
    cp "$1" "$2.new"
    say "$(basename "$2") already exists and differs — kept yours; shipped copy at $2.new"
  fi
}

# ---------- per-role conversation registry ---------------------------------------
# <git-common-dir>/ai-team/sessions/<role>: shell-sourceable KEY=VALUE lines
# (ROLE, CLI, SESSION_ID, CWD, MODEL, STATUS, STARTED_AT, UPDATED_AT, and
# SNAPSHOT for codex discovery). One file per role, written only by the
# launcher. Stores ids and metadata only — never tokens, never transcript
# content.
is_uuid() {
  printf '%s' "$1" | grep -qE '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
}

new_uuid() { python3 -c 'import uuid; print(uuid.uuid4())'; }

now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }

reg_get() { # $1 mailbox $2 role $3 key -> value ('' when absent)
  local f
  f="$1/sessions/$2"
  [ -f "$f" ] || return 0
  grep -E "^$3=" "$f" 2>/dev/null | tail -1 | cut -d= -f2-
}

reg_write() { # $1 mailbox $2 role $3.. KEY=VALUE... (atomic replace)
  local f kv
  f="$1/sessions/$2"
  mkdir -p "${f%/*}"
  for kv in "${@:3}"; do printf '%s\n' "$kv"; done > "$f.tmp" && mv "$f.tmp" "$f"
}

claude_session_exists() { # $1 session id -> transcript still on disk?
  is_uuid "$1" || return 1
  find "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects" -maxdepth 2 -name "$1.jsonl" 2>/dev/null | grep -q .
}

codex_session_exists() { # $1 session id -> known to this codex install?
  is_uuid "$1" || return 1
  local ch="${CODEX_HOME:-$HOME/.codex}"
  grep -q "\"$1\"" "$ch/session_index.jsonl" 2>/dev/null && return 0
  find "$ch/sessions" -name "*$1*" 2>/dev/null | grep -q .
}

path_eq() { # $1 $2 -> same directory (physical-path aware; missing dirs compare literally)
  [ "$1" = "$2" ] && return 0
  local a b
  a="$(cd "$1" 2>/dev/null && pwd -P)" || return 1
  b="$(cd "$2" 2>/dev/null && pwd -P)" || return 1
  [ "$a" = "$b" ]
}

codex_index_ids_since() { # $1 snapshot line count -> minted ids, newest first
  local ch="${CODEX_HOME:-$HOME/.codex}"
  local snap="${1:-0}"
  case "$snap" in *[!0-9]*) snap=0 ;; esac
  tail -n +"$((snap + 1))" "$ch/session_index.jsonl" 2>/dev/null | python3 -c '
import sys, json
ids = []
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        i = json.loads(line).get("id", "")
    except Exception:
        continue
    if i:
        ids.append(i)
for i in reversed(ids):
    print(i)
'
}

codex_rollout_cwd() { # $1 id -> cwd recorded in its rollout session_meta ('' if unknown)
  local ch="${CODEX_HOME:-$HOME/.codex}" f
  f="$(find "$ch/sessions" -name "*$1*" -type f 2>/dev/null | head -1)"
  [ -n "$f" ] || return 0
  python3 -c '
import sys, json
with open(sys.argv[1]) as fh:
    first = fh.readline()
d = json.loads(first)
p = d.get("payload", {}) or {}
print(p.get("cwd", ""))
' "$f" 2>/dev/null
}

codex_new_ids_since() { # $1 snapshot $2 workspace cwd -> newest id bound to that cwd
  local id
  while IFS= read -r id; do
    is_uuid "$id" || continue
    path_eq "$(codex_rollout_cwd "$id")" "$2" || continue
    printf '%s' "$id"
    return 0
  done <<EOF
$(codex_index_ids_since "$1")
EOF
}

reg_follow_cli() { # $1 mailbox $2 role $3 configured cli
  # A conversation id belongs to the CLI that minted it (claude and zai
  # differ too: same binary, another backend). When the configured CLI is
  # not the recorded one, park the entry as sessions/<role>.<cli> and bring
  # back the entry parked for the configured CLI, if there is one. The role
  # then never resumes a foreign id, and it finds its own conversation
  # again when the config switches back.
  local d="$1/sessions" was
  was="$(reg_get "$1" "$2" CLI)"
  [ -n "$was" ] && [ "$was" != "$3" ] || return 0
  case "$was" in
    codex|claude|zai) mv "$d/$2" "$d/$2.$was" ;;
    *) rm -f "$d/$2" ;;   # not an entry this launcher wrote
  esac
  if [ -f "$d/$2.$3" ]; then mv "$d/$2.$3" "$d/$2"; fi
}

reg_set_codex_id() { # $1 mailbox $2 role $3 id — record discovered id, mark live
  local m="$1" r="$2"
  reg_write "$m" "$r" \
    "ROLE=$r" "CLI=codex" "SESSION_ID=$3" \
    "CWD=$(reg_get "$m" "$r" CWD)" "MODEL=$(reg_get "$m" "$r" MODEL)" \
    "STATUS=live" "STARTED_AT=$(reg_get "$m" "$r" STARTED_AT)" \
    "UPDATED_AT=$(now_utc)" "SNAPSHOT=$(reg_get "$m" "$r" SNAPSHOT)"
}

# ---------- active team record ---------------------------------------------------
# <mailbox>/active: the tmux session that owns this repo's mailbox right now
# and the config that started it. Same KEY=VALUE shape as the registry
# (SESSION, CREATED, CONFIG, ROOT, STARTED_AT), written only by the launcher
# and read with grep, never sourced. CREATED is the session's tmux creation
# stamp: the record vouches for that one session. When the session is gone,
# or another session took its name, the record is stale and ignored.
team_get() { # $1 mailbox $2 key -> value ('' when absent)
  [ -f "$1/active" ] || return 0
  grep -E "^$2=" "$1/active" 2>/dev/null | tail -1 | cut -d= -f2-
}

team_write() { # $1 mailbox $2.. KEY=VALUE... (atomic replace)
  local f="$1/active" kv
  for kv in "${@:2}"; do printf '%s\n' "$kv"; done > "$f.tmp" && mv "$f.tmp" "$f"
}

session_created() { # $1 session name -> creation stamp ('' when not running)
  tmux list-sessions -F '#{session_created} #{session_name}' 2>/dev/null \
    | awk -v n="$1" '{ c = $1; sub(/^[^ ]+ /, ""); if ($0 == n) { print c; exit } }'
}

default_conf() { # $1 team root -> default config path ('' when there is none)
  local p="$1/ai-team.conf"
  [ -f "$p" ] || p="$TOOL_HOME/ai-team.conf"
  [ -f "$p" ] || return 0
  abs_path "$p"
}

conf_session() { # $1 team root $2 conf -> session name that config yields ('' if unreadable)
  local out
  [ -n "$2" ] || return 0
  out="$(conf_read "$2" 2>/dev/null)" || return 0
  session_name "$1" "$(printf '%s' "$out" | head -1 | cut -d "$TSV_SEP" -f1)"
}

# find_active <mailbox> <default conf> <session name>...
# Sets ACTIVE_SESSION and ACTIVE_CONFIG for the team running in this repo
# (both '' when none runs), ACTIVE_MODE (full or workers), and
# ACTIVE_RECORDED (1 when the launch record vouches for it). A running
# session under one of the given names without a record was started by a
# launcher that wrote none. Such a launcher knew the default config and the
# full team only, so that is what it is attributed to. A record without
# MODE predates workers mode and is a full team too.
find_active() {
  local mailbox="$1" dconf="$2" name created
  ACTIVE_SESSION="" ACTIVE_CONFIG="" ACTIVE_RECORDED=0 ACTIVE_MODE=""
  name="$(team_get "$mailbox" SESSION)"
  if [ -n "$name" ]; then
    created="$(session_created "$name")"
    if [ -n "$created" ] && [ "$created" = "$(team_get "$mailbox" CREATED)" ]; then
      ACTIVE_SESSION="$name"
      ACTIVE_CONFIG="$(team_get "$mailbox" CONFIG)"
      ACTIVE_MODE="$(team_get "$mailbox" MODE)"
      ACTIVE_MODE="${ACTIVE_MODE:-full}"
      ACTIVE_RECORDED=1
      return 0
    fi
  fi
  for name in "${@:3}"; do
    [ -n "$name" ] || continue
    if [ -n "$(session_created "$name")" ]; then
      ACTIVE_SESSION="$name"
      ACTIVE_CONFIG="$dconf"
      ACTIVE_MODE=full
      return 0
    fi
  done
}

hint_mode() { # $1 team mode -> ' --workers' ('' for the full team)
  [ "$1" = workers ] && printf ' --workers'
  return 0
}

mode_tag() { # $1 team mode -> ' (workers only)' ('' for the full team)
  [ "$1" = workers ] && printf ' (workers only)'
  return 0
}

hint_conf() { # $1 conf $2 team root $3 default conf -> ' --config <path>' ('' for the default)
  [ -n "$1" ] && [ "$1" != "$3" ] || return 0
  printf ' --config %s' "$(hint_path "$1" "$2")"
}

# refuse_other_config <mode> <requested conf> <team root> <default conf> [requested team mode]
# The running team was started with another config, or in another team
# mode (full or workers): explain, change nothing.
refuse_other_config() {
  local mode="$1" req="$2" root="$3" dconf="$4" rmode="${5:-}" running what="config"
  running="${ACTIVE_CONFIG:-unknown}$(mode_tag "$ACTIVE_MODE")"
  [ "$ACTIVE_RECORDED" = 1 ] || running="$running (no launch record: assumed)"
  [ "$ACTIVE_CONFIG" = "$req" ] && what="mode"
  say "session $ACTIVE_SESSION is running with another $what. Nothing was changed."
  say "  running:   $running"
  say "  requested: $req$(mode_tag "$rmode")"
  say "One team runs per repo: the mailbox and the role worktrees are shared. Stop the running session before switching configs or modes."
  case "$mode" in
    up)
      say "  stop it:       scripts/ai-team --kill"
      say "  then start:    scripts/ai-team up$(hint_mode "$rmode")$(hint_conf "$req" "$root" "$dconf")"
      say "  or go back to the running team: scripts/ai-team up$(hint_mode "$ACTIVE_MODE")$(hint_conf "$ACTIVE_CONFIG" "$root" "$dconf")"
      ;;
    *)
      say "  $mode without --config acts on the running team: scripts/ai-team $mode"
      ;;
  esac
  exit 1
}

# follow_team <mode> <team root> <mailbox> <--config value>
# What --verify and --kill act on. Without --config they follow the running
# team, whichever config started it, and fall back to the default config
# when nothing runs. With --config, that config must be the running one.
# Sets ACTIVE_* (find_active), T_CONF ('' = no config file to read), and
# T_NAMED (1 = T_CONF is a config somebody chose: it has to exist and parse).
follow_team() {
  local mode="$1" root="$2" mailbox="$3" arg="$4" dconf req=""
  dconf="$(default_conf "$root")"
  if [ -n "$arg" ]; then
    req="$(resolve_conf "$root" "$arg")" || exit $?
  fi
  find_active "$mailbox" "$dconf" "$(conf_session "$root" "$req")" "$(conf_session "$root" "$dconf")"
  T_NAMED=1
  if [ -n "$req" ]; then
    [ -z "$ACTIVE_SESSION" ] || [ "$ACTIVE_CONFIG" = "$req" ] \
      || refuse_other_config "$mode" "$req" "$root" "$dconf"
    T_CONF="$req"
  elif [ -n "$ACTIVE_SESSION" ] && [ -n "$ACTIVE_CONFIG" ] && [ "$ACTIVE_CONFIG" != "$dconf" ]; then
    T_CONF="$ACTIVE_CONFIG"
  else
    T_CONF="$dconf"
    T_NAMED=0
  fi
}

# ---------- init ---------------------------------------------------------------

cmd_init() {
  local root src
  root="$(repo_root)" || exit $?
  src="$TOOL_HOME"
  [ -f "$src/.agents/AGENTS-SECTION.md" ] || die "tool files incomplete at $src (missing .agents/AGENTS-SECTION.md)"

  mkdir -p "$root/.agents/roles" "$root/.agents/lib" "$root/.agents/doc-templates" "$root/scripts"
  local f
  for f in "$src"/.agents/roles/*.md; do
    install_file "$f" "$root/.agents/roles/$(basename "$f")"
  done
  for f in "$src"/.agents/doc-templates/*.md; do
    install_file "$f" "$root/.agents/doc-templates/$(basename "$f")"
  done
  install_file "$src/.agents/lib/task.sh" "$root/.agents/lib/task.sh"
  install_file "$src/.agents/lib/pane.sh" "$root/.agents/lib/pane.sh"
  install_file "$src/.agents/lib/delegator.sh" "$root/.agents/lib/delegator.sh"
  install_file "$src/.agents/AGENTS-SECTION.md" "$root/.agents/AGENTS-SECTION.md"
  install_file "$src/scripts/ai-team" "$root/scripts/ai-team"
  chmod +x "$root/scripts/ai-team" "$root/.agents/lib/"*.sh
  [ -f "$root/scripts/ai-team.new" ] && chmod +x "$root/scripts/ai-team.new"

  if [ ! -f "$root/ai-team.conf" ]; then
    cp "$src/ai-team.conf" "$root/ai-team.conf"
    say "wrote ai-team.conf (user-owned: edit models/panes here; init never overwrites it)"
  else
    say "ai-team.conf already present — left untouched"
  fi

  # AGENTS.md marked section: replace if present, else append; never touch
  # anything outside the markers.
  python3 - "$root" <<'PY'
import sys, os, re
root = sys.argv[1]
section = open(os.path.join(root, ".agents/AGENTS-SECTION.md")).read()
ag = os.path.join(root, "AGENTS.md")
s = open(ag).read() if os.path.exists(ag) else ""
s = re.sub(r"\n?# >>> ai-team >>>.*?# <<< ai-team <<<\n?", "\n", s, flags=re.S)
s = s.rstrip("\n") + ("\n\n" if s.strip() else "") + section.rstrip("\n") + "\n"
open(ag, "w").write(s)
PY

  local common
  common="$(git_common_dir "$root")" || exit $?
  ensure_exclude "$common" ".ai-team-worktrees/"

  say "initialized in $root"
  echo "next: edit ai-team.conf if needed, then run ./scripts/ai-team up" >&2
}

# ---------- up -----------------------------------------------------------------

cmd_up() { # $1 attach (1|0)  $2 --config value ('' = default config)  $3 workers only (1|0)
  local mode_attach="$1" conf_arg="$2" team_mode=full
  [ "${3:-0}" = 1 ] && team_mode=workers

  command -v tmux >/dev/null 2>&1 || die "tmux not found (brew install tmux / apt install tmux)"
  command -v python3 >/dev/null 2>&1 || die "python3 not found"

  local root conf
  root="$(team_root)" || exit $?
  conf="$(resolve_conf "$root" "$conf_arg")" || exit $?
  local confdesc="tool-home"
  [ "$conf" = "$(abs_path "$root/ai-team.conf")" ] && confdesc="project"
  [ -n "$conf_arg" ] && confdesc="--config"

  local confout prefix zai_env_raw ttl
  confout="$(conf_read "$conf")" || die "cannot parse $conf"
  prefix="$(printf '%s' "$confout"   | head -1 | cut -d "$TSV_SEP" -f1)"
  zai_env_raw="$(printf '%s' "$confout" | head -1 | cut -d "$TSV_SEP" -f2)"
  ttl="$(printf '%s' "$confout"      | head -1 | cut -d "$TSV_SEP" -f3)"
  local zai_env="${zai_env_raw/#\~/$HOME}"

  local sess
  sess="$(session_name "$root" "$prefix")"

  # One team per repo: look for a running team before any side effect. The
  # config and mode that started it reattach. Anything else is refused.
  local common mailbox dconf
  common="$(git_common_dir "$root")" || exit $?
  mailbox="$common/ai-team"
  dconf="$(default_conf "$root")"
  find_active "$mailbox" "$dconf" "$sess" "$(conf_session "$root" "$dconf")"
  if [ -n "$ACTIVE_SESSION" ]; then
    [ "$ACTIVE_CONFIG" = "$conf" ] && [ "$ACTIVE_MODE" = "$team_mode" ] \
      || refuse_other_config up "$conf" "$root" "$dconf" "$team_mode"
    sess="$ACTIVE_SESSION"
    say "session $sess already running — reattaching (no duplicate launched)"
    [ "$mode_attach" = 1 ] && exec tmux attach-session -t "=$sess"
    echo "$sess"
    return 0
  fi

  # ---- preflight: config + CLIs (fail before creating anything) -------------
  local tsv roles="" missing=""
  tsv="$(printf '%s' "$confout" | tail -n +2)"
  if [ "$team_mode" = workers ]; then
    # The Delegator runs outside tmux: its section is neither checked nor
    # started, and its registry entry is never touched.
    tsv="$(printf '%s\n' "$tsv" | awk -F "$TSV_SEP" '$1 != "delegator"')"
    [ "$(printf '%s' "$tsv" | grep -c .)" -eq 5 ] \
      || die "expected 5 worker [pane.*] sections (all but delegator) in $conf ($confdesc), found $(printf '%s' "$tsv" | grep -c .)"
  else
    [ "$(printf '%s' "$tsv" | grep -c .)" -eq 6 ] \
      || die "expected 6 [pane.*] sections in $conf ($confdesc), found $(printf '%s' "$tsv" | grep -c .)"
  fi

  while IFS="$TSV_SEP" read -r role label cli model effort worktree; do
    roles="$roles $role"
    [ -n "$cli" ] || die "[$role] cli is empty in $conf"
    case "$cli" in
      codex|claude) command -v "$cli" >/dev/null 2>&1 || missing="$missing $cli" ;;
      zai)
        command -v claude >/dev/null 2>&1 || missing="$missing claude(for zai)"
        [ -f "$zai_env" ] || die "[$role] cli=zai but env file not found: $zai_env (set [workspace] zai_env in $conf)"
        ;;
      *) die "[$role] unknown cli '$cli' (expected codex | claude | zai)" ;;
    esac
    [ -n "$model" ] || die "[$role] model is empty — set it in $conf (no silent defaults)"
  done <<EOF
$tsv
EOF
  [ -z "$missing" ] || die "required CLI(s) not on PATH:$missing"
  # --verify + exit status: plain `rev-parse HEAD` in an unborn repo prints
  # the literal word HEAD (rc 128), which the old -n test mistook for a ref.
  git -C "$root" rev-parse --verify --quiet HEAD >/dev/null 2>&1 \
    || die "repo has no commits yet — make an initial commit first (worktrees need HEAD)"

  # Resolve CLIs to absolute paths NOW: pane shells may rewrite PATH
  # (e.g. ~/.zshenv prepending ~/.local/bin), which would otherwise swap the
  # binary under us between launch and boot.
  local CODEX_BIN CLAUDE_BIN
  CODEX_BIN="$(command -v codex)"
  CLAUDE_BIN="$(command -v claude)"

  # ---- workspace: mailbox + worktrees ----------------------------------------
  mkdir -p "$mailbox/tasks" "$mailbox/acks" "$mailbox/sessions" || die "cannot create mailbox at $mailbox"
  ensure_exclude "$common" ".ai-team-worktrees/"

  local role worktree wt_root branch
  wt_root="$root/.ai-team-worktrees"
  while IFS="$TSV_SEP" read -r role label cli model effort worktree; do
    [ "$worktree" = "yes" ] || continue
    branch="ai-team/$role"
    if git -C "$wt_root/$role" rev-parse --git-dir >/dev/null 2>&1; then
      say "worktree exists: $wt_root/$role (reused, untouched)"
      continue
    fi
    if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$root" worktree add "$wt_root/$role" "$branch" >/dev/null \
        || die "cannot add worktree $wt_root/$role on existing branch $branch (left untouched)"
    else
      git -C "$root" worktree add -b "$branch" "$wt_root/$role" >/dev/null \
        || die "cannot create worktree/branch $branch"
    fi
    say "worktree ready: $wt_root/$role (branch $branch)"
  done <<EOF
$tsv
EOF

  # ---- pane command builder ---------------------------------------------------
  local lib_dir="$root/.agents/lib"
  [ -d "$lib_dir" ] || lib_dir="$TOOL_HOME/.agents/lib"

  pane_cmd() { # role cli model effort cwd rolefile sid mode -> pane shell command
    local prole="$1" pcli="$2" pmodel="$3" peffort="$4" pcwd="$5" pfile="$6" psid="$7" pmode="$8"
    local envs qfile qmailbox qlib sflag
    qfile="$(shell_quote "$pfile")"
    qmailbox="$(shell_quote "$mailbox")"
    qlib="$(shell_quote "$lib_dir")"
    # export (a shell builtin) rather than the env binary: the zai pane starts
    # with `.` (source), which env cannot execute.
    envs="export AGENT_ROLE=$(shell_quote "$prole") AGENT_ID=$(shell_quote "$sess-$prole") \
AGENT_ROLE_FILE=$qfile AGENT_MAILBOX=$qmailbox AGENT_LIB_DIR=$qlib;"
    local base="" bin
    sflag="--session-id"
    [ "$pmode" = resume ] && sflag="--resume"
    # The Delegator is the user's interface: a fresh one acknowledges and
    # reports READY by itself, whatever CLI runs it. claude and zai carry
    # the role file in the system prompt, so their first message skips it
    # (codex has no such flag and gets the file named in its prompt below).
    # Workers get no message and idle until addressed. A resumed
    # conversation has had its handshake. The message is quoted as a whole:
    # it reaches the CLI as one argument whatever the paths contain.
    local hello=""
    if [ "$prole" = delegator ] && [ "$pmode" != resume ]; then
      hello=" $(shell_quote "You are the team Delegator. Your role file is loaded in the system prompt. \
Read AGENTS.md in $(shell_quote "$pcwd"), run: bash $qlib/task.sh ack, and reply READY only.")"
    fi
    case "$pcli" in
      codex)
        bin="$(shell_quote "$CODEX_BIN")"
        # Reasoning effort has no --effort flag on codex. It rides as a -c
        # config override. shell_quote keeps the configured value a single
        # safe word. Empty effort means: let codex use its own default.
        local qeff=""
        [ -n "$peffort" ] && qeff="-c model_reasoning_effort=$(shell_quote "$peffort")"
        # Full access mode (user request): no approval prompts, no sandbox.
        if [ "$pmode" = resume ]; then
          # explicit-id resume: flags belong to the resume subcommand
          # (codex-cli 0.156.1 help); never --last/--continue (picker would
          # be cwd-scoped across roles).
          base="$bin resume $(shell_quote "$psid") --dangerously-bypass-approvals-and-sandbox -m $(shell_quote "$pmodel") $qeff -C $(shell_quote "$pcwd")"
        else
          base="$bin --dangerously-bypass-approvals-and-sandbox -m $(shell_quote "$pmodel") $qeff \
\"You are the team Delegator. Read $(shell_quote "$pfile") and adopt the role. \
Then read AGENTS.md in $(shell_quote "$pcwd"), run: bash $qlib/task.sh ack, and reply READY only.\""
        fi
        ;;
      claude)
        bin="$(shell_quote "$CLAUDE_BIN")"
        base="unset $CLAUDE_ROUTING_VARS; $bin $sflag $(shell_quote "$psid") --model $(shell_quote "$pmodel")"
        [ -n "$peffort" ] && base="$base --effort $(shell_quote "$peffort")"
        base="$base --append-system-prompt-file $qfile$hello"
        ;;
      zai)
        bin="$(shell_quote "$CLAUDE_BIN")"
        base="unset $CLAUDE_ROUTING_VARS; . $(shell_quote "$zai_env") && $bin $sflag $(shell_quote "$psid") --model $(shell_quote "$pmodel")"
        [ -n "$peffort" ] && base="$base --effort $(shell_quote "$peffort")"
        base="$base --append-system-prompt-file $qfile$hello"
        ;;
    esac
    printf '%s %s' "$envs" "$base"
  }

  # ---- build the tmux session -------------------------------------------------
  say "building session $sess (panes will show role labels; CLIs boot in place)"
  local -a order_roles order_clis order_cmds order_cwds
  local line idx=0
  while IFS="$TSV_SEP" read -r role label cli model effort worktree; do
    order_roles[$idx]="$role"
    order_clis[$idx]="$cli"
    local cwd="$root"
    [ "$worktree" = "yes" ] && cwd="$wt_root/$role"
    order_cwds[$idx]="$cwd"

    # conversation persistence: resume the stored id only when its transcript
    # still exists; otherwise start fresh and store the new id (claude/zai)
    # or discover codex's minted id after boot. Never --continue/--last:
    # panes share cwd, so "most recent" could cross roles.
    local sid mode status snap=""
    reg_follow_cli "$mailbox" "$role" "$cli"
    sid="$(reg_get "$mailbox" "$role" SESSION_ID)"
    case "$cli" in
      claude|zai)
        if claude_session_exists "$sid"; then
          mode=resume
        else
          mode=fresh
          sid="$(new_uuid)"
        fi
        ;;
      codex)
        if codex_session_exists "$sid"; then
          mode=resume
        else
          mode=fresh
          sid=""
          snap="$(wc -l < "${CODEX_HOME:-$HOME/.codex}/session_index.jsonl" 2>/dev/null | tr -d ' ')"
        fi
        ;;
    esac
    status=live
    [ "$mode" = fresh ] && status=pending
    local -a reg=(ROLE="$role" CLI="$cli" SESSION_ID="$sid" CWD="$cwd" MODEL="$model" \
      STATUS="$status" UPDATED_AT="$(now_utc)")
    [ "$mode" = fresh ] && reg+=(STARTED_AT="$(now_utc)" SNAPSHOT="$snap")
    reg_write "$mailbox" "$role" "${reg[@]}"

    order_cmds[$idx]="$(pane_cmd "$role" "$cli" "$model" "$effort" "$cwd" "$root/.agents/roles/$role.md" "$sid" "$mode")"
    [ -f "$root/.agents/roles/$role.md" ] || order_cmds[$idx]="$(pane_cmd "$role" "$cli" "$model" "$effort" "$cwd" "$TOOL_HOME/.agents/roles/$role.md" "$sid" "$mode")"
    idx=$((idx + 1))
  done <<EOF
$tsv
EOF

  pane_ids_of() { tmux list-panes -t "=$sess" -F '#{pane_id}' 2>/dev/null | sort; }
  diff_new_pane() { # prints the pane id added since $1 (sorted list)
    comm -13 <(printf '%s\n' "$1") <(pane_ids_of) | head -1
  }

  # Layout (T-0052): two equal-width columns. The Delegator stays alone at
  # full height on the left; the other five roles stack down the right in
  # config order. p0 is split -h once (order 1, researcher, becomes the
  # right-column top pane p1), then the right column cascades downward on
  # the bottom carrier with 80/75/67/50 splits (orders 2-5 into p2..p5),
  # which keeps every carrier large enough to continue (a naive 50/50
  # cascade runs out of pane). Sequential percent splits leave a 1..2-line
  # height spread, so exact content heights are set afterwards by
  # resize-pane (custom select-layout strings are rejected by this tmux
  # build).
  local before pid
  tmux new-session -d -s "$sess" -n team -c "${order_cwds[0]}" "${order_cmds[0]}"
  tmux has-session -t "=$sess" 2>/dev/null \
    || die "pane boot failed: '${order_roles[0]}' exited immediately (session rolled back). Run its pane command by hand to see why — common causes: invalid model id, CLI auth/config error."
  team_write "$mailbox" "SESSION=$sess" "CREATED=$(session_created "$sess")" \
    "CONFIG=$conf" "ROOT=$root" "STARTED_AT=$(now_utc)" "MODE=$team_mode"
  local p0 p1 p2 p3 p4 p5
  p0="$(pane_ids_of)"
  tmux rename-window -t "=$sess" "team"
  tmux set-window-option -t "=$sess" remain-on-exit on >/dev/null
  # Border status must be on BEFORE any splits/resizes: enabling it later
  # shrinks the pane grid by a line and tmux re-tiles proportionally,
  # wiping exact pane heights set by the resize step below.
  tmux set-window-option -t "=$sess" pane-border-status top >/dev/null

  # Drop routing vars from OUR session environment only, so anyone inspecting
  # `tmux show-environment -t` sees a clean session. The server-global
  # environment is left exactly as found: unrelated sessions may depend on it.
  # Panes still merge the global env back in; the in-pane unset in the pane
  # command removes it before claude runs, so claude never sees routing vars.
  local v
  for v in $CLAUDE_ROUTING_VARS; do
    tmux set-environment -u -t "=$sess" "$v" 2>/dev/null
  done

  # pane ids in conf/role order (one per split step): the die message and
  # the role->pane registry map by role, not by split order. col holds the
  # five-pane column that gets equal heights.
  local -a role_pids col
  if [ "$team_mode" = workers ]; then
    # Workers mode: no Delegator pane. The five workers fill one full-width
    # column top to bottom in config order, grown from p0 with the same
    # 80/75/67/50 cascade as the full team's right column.
    before="$(pane_ids_of)"
    tmux split-window -d -v -p 80 -t "$p0" -c "${order_cwds[1]}" "${order_cmds[1]}"
    p1="$(diff_new_pane "$before")"

    before="$(pane_ids_of)"
    tmux split-window -d -v -p 75 -t "$p1" -c "${order_cwds[2]}" "${order_cmds[2]}"
    p2="$(diff_new_pane "$before")"

    before="$(pane_ids_of)"
    tmux split-window -d -v -p 67 -t "$p2" -c "${order_cwds[3]}" "${order_cmds[3]}"
    p3="$(diff_new_pane "$before")"

    before="$(pane_ids_of)"
    tmux split-window -d -v -p 50 -t "$p3" -c "${order_cwds[4]}" "${order_cmds[4]}"
    p4="$(diff_new_pane "$before")"
    col=("$p0" "$p1" "$p2" "$p3" "$p4")
    role_pids=("${col[@]}")
  else
    before="$(pane_ids_of)"
    tmux split-window -d -h -p 50 -t "$p0" -c "${order_cwds[1]}" "${order_cmds[1]}"
    p1="$(diff_new_pane "$before")"

    before="$(pane_ids_of)"
    tmux split-window -d -v -p 80 -t "$p1" -c "${order_cwds[2]}" "${order_cmds[2]}"
    p2="$(diff_new_pane "$before")"

    before="$(pane_ids_of)"
    tmux split-window -d -v -p 75 -t "$p2" -c "${order_cwds[3]}" "${order_cmds[3]}"
    p3="$(diff_new_pane "$before")"

    before="$(pane_ids_of)"
    tmux split-window -d -v -p 67 -t "$p3" -c "${order_cwds[4]}" "${order_cmds[4]}"
    p4="$(diff_new_pane "$before")"

    before="$(pane_ids_of)"
    tmux split-window -d -v -p 50 -t "$p4" -c "${order_cwds[5]}" "${order_cmds[5]}"
    p5="$(diff_new_pane "$before")"
    col=("$p1" "$p2" "$p3" "$p4" "$p5")
    role_pids=("$p0" "${col[@]}")
  fi

  # Exact equal sizing, grammar-free: resize the top four column panes to a
  # computed content height; tmux redistributes within the column only.
  # The pane grid is wh-1 (the border-status line); the five column panes
  # share grid-4 content lines, any remainder spread one line at a time
  # from the top. In the full team the delegator keeps the full grid
  # height. Below a sane minimum, leave the proportional splits in place.
  local ww wh grid rbase rrem
  ww=$(tmux display-message -p -t "$p0" '#{window_width}')
  wh=$(tmux display-message -p -t "$p0" '#{window_height}')
  grid=$((wh - 1))
  if [ "${ww:-0}" -ge 20 ] && [ "$grid" -ge 10 ]; then
    rbase=$(( (grid - 4) / 5 ))
    rrem=$(( (grid - 4) - rbase * 5 ))
    tmux resize-pane -t "${col[0]}" -y $(( rbase + (rrem > 0 ? 1 : 0) )) 2>/dev/null
    tmux resize-pane -t "${col[1]}" -y $(( rbase + (rrem > 1 ? 1 : 0) )) 2>/dev/null
    tmux resize-pane -t "${col[2]}" -y $(( rbase + (rrem > 2 ? 1 : 0) )) 2>/dev/null
    tmux resize-pane -t "${col[3]}" -y $(( rbase + (rrem > 3 ? 1 : 0) )) 2>/dev/null
  fi
  local _pid _i=0
  for _pid in "${role_pids[@]}"; do
    case "$_pid" in
      %*) ;;
      *) tmux kill-session -t "=$sess" 2>/dev/null
         rm -f "$mailbox/active"
         die "pane boot failed: '${order_roles[$_i]}' exited immediately or its pane id could not be captured (session rolled back). Run the pane command by hand to see why." ;;
    esac
    _i=$((_i + 1))
  done

  # codex mints its own session id on first boot: poll the session index and
  # store the minted id only when its rollout session_meta cwd matches this
  # workspace, so a concurrent foreign codex session can never win. If no
  # match appears (slow or old codex, dead pane), the entry stays pending and
  # `--verify` backfills it with the same cwd filter.
  local drole dlabel dcli dmodel deffort dworktree did dtries
  while IFS="$TSV_SEP" read -r drole dlabel dcli dmodel deffort dworktree; do
    if [ "$dcli" = codex ] && [ "$(reg_get "$mailbox" "$drole" STATUS)" = pending ] \
       && [ -z "$(reg_get "$mailbox" "$drole" SESSION_ID)" ]; then
      did=""
      dtries=0
      while [ "$dtries" -lt 20 ]; do
        did="$(codex_new_ids_since "$(reg_get "$mailbox" "$drole" SNAPSHOT)" "$(reg_get "$mailbox" "$drole" CWD)")"
        [ -n "$did" ] && break
        dtries=$((dtries + 1))
        sleep 0.25
      done
      [ -n "$did" ] && reg_set_codex_id "$mailbox" "$drole" "$did"
    fi
  done <<EOF
$tsv
EOF

  # Labels + pane registry (role -> pane id, used by pane.sh)
  local -a pids=("${role_pids[@]}")
  : > "$mailbox/panes.tsv"
  local i labels
  i=0
  while IFS="$TSV_SEP" read -r role label cli model effort worktree; do
    tmux select-pane -t "${pids[$i]}" -T "$label"
    printf '%s\t%s\n' "$role" "${pids[$i]}" >> "$mailbox/panes.tsv"
    i=$((i + 1))
  done <<EOF
$tsv
EOF

  say "workspace up: $sess"
  say "config: $conf"
  if [ "$team_mode" = workers ]; then
    say "workers only: no Delegator pane. Workers idle until addressed. Run the Delegator in your own terminal and reach the mailbox with: bash .agents/lib/delegator.sh task|pane ..."
  else
    say "${order_roles[0]} = pane $p0 (${order_clis[0]}). Workers idle until addressed. Role files are pre-loaded via system prompt (claude/zai) or the startup prompt (codex)."
    [ "${order_clis[0]}" = codex ] \
      && say "voice: the Codex CLI has no voice mode; use Codex.app separately if you need voice."
  fi
  if [ "$mode_attach" = 1 ]; then
    exec tmux attach-session -t "=$sess"
  fi
  echo "$sess"
}

# ---------- verify / check-models / kill ----------------------------------------

# team_confout <team root>: parsed records of T_CONF (follow_team). The
# default config keeps the lenient fallback it always had here.
team_confout() {
  if [ "$T_NAMED" = 1 ]; then
    [ -f "$T_CONF" ] || die "config file not found: $T_CONF (session $ACTIVE_SESSION was started with it)"
    conf_read "$T_CONF" || die "cannot parse $T_CONF"
  else
    conf_read "${T_CONF:-$1/ai-team.conf}" 2>/dev/null || conf_read "$TOOL_HOME/ai-team.conf"
  fi
}

cmd_verify() { # $1 --config value ('' = the running team, else the default config)
  local root confout prefix sess
  root="$(team_root)" || exit $?
  local mailbox; mailbox="$(git_common_dir "$root")/ai-team" || exit $?
  follow_team --verify "$root" "$mailbox" "$1"
  confout="$(team_confout "$root")" || exit $?
  prefix="$(printf '%s' "$confout" | head -1 | cut -d "$TSV_SEP" -f1)"
  sess="${ACTIVE_SESSION:-$(session_name "$root" "$prefix")}"
  echo "session: $sess ($(tmux has-session -t "=$sess" 2>/dev/null && echo up || echo DOWN))"
  echo "config:  ${T_CONF:-none}"
  [ "$ACTIVE_MODE" = workers ] && echo "mode:    workers only (the Delegator runs outside tmux)"
  while IFS="$TSV_SEP" read -r role label cli model effort worktree; do
    local pid ack="no" alive="gone" ack_time="" bid=""
    pid=$(awk -F '\t' -v r="$role" '$1 == r {print $2; exit}' "$mailbox/panes.tsv" 2>/dev/null)
    [ -n "$pid" ] && tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx "$pid" && alive="pane $pid"
    [ "$role" = delegator ] && [ "$ACTIVE_MODE" = workers ] && alive="external"
    # backfill a codex id that boot-time discovery missed (partial boot);
    # same cwd binding as boot-time discovery, never a foreign session.
    # Not for an external Delegator: the user's own Codex session may run in
    # this directory, and cwd is all discovery goes by.
    if [ "$cli" = codex ] && [ "$alive" != external ] \
       && [ "$(reg_get "$mailbox" "$role" STATUS)" = pending ] \
       && [ -z "$(reg_get "$mailbox" "$role" SESSION_ID)" ]; then
      bid="$(codex_new_ids_since "$(reg_get "$mailbox" "$role" SNAPSHOT)" "$(reg_get "$mailbox" "$role" CWD)")"
      [ -n "$bid" ] && reg_set_codex_id "$mailbox" "$role" "$bid"
    fi
    if [ -f "$mailbox/acks/$role.json" ]; then
      # ack records are JSON (T-0003 format); fall back to a bare "yes" for
      # missing time fields or legacy/unreadable records rather than crashing
      ack_time="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("time",""))' "$mailbox/acks/$role.json" 2>/dev/null)"
      case "$ack_time" in
        ?*) ack="yes ($ack_time)" ;;
        *)  ack="yes" ;;
      esac
    fi
    printf '%-12s %-22s ack=%-28s %s\n' "$role" "$alive" "$ack" "$label"
  done <<EOF
$(printf '%s' "$confout" | tail -n +2)
EOF
  echo "ack=no means the pane has not yet acted on its first message (role file is still pre-loaded via system prompt / startup prompt)."
}

cmd_check_models() { # $1 --config value ('' = default config)
  local root conf confout zai_env_raw zai_env
  root="$(team_root)" || exit $?
  conf="$(resolve_conf "$root" "$1")" || exit $?
  confout="$(conf_read "$conf")" || die "cannot parse $conf"
  zai_env_raw="$(printf '%s' "$confout" | head -1 | cut -d "$TSV_SEP" -f2)"
  zai_env="${zai_env_raw/#\~/$HOME}"
  # cli=zai panes must probe through the configured env file — refuse clearly
  # (same rule as `up`) rather than probing the default endpoint.
  if printf '%s' "$confout" | tail -n +2 | awk -v FS="$TSV_SEP" '$3 == "zai"' | grep -q .; then
    [ -f "$zai_env" ] || die "cli=zai configured but env file not found: $zai_env (set [workspace] zai_env in $conf)"
  fi
  echo "probing models with one tiny request each (costs a little quota; claude panes: clean env, zai panes: env file)"
  local -a probe_env
  while IFS="$TSV_SEP" read -r role label cli model effort worktree; do
    probe_env=(env -i HOME="$HOME" PATH="$PATH")
    # STUB_LOG is a test-suite hook (stub CLIs log there); unset in real use.
    [ -n "${STUB_LOG:-}" ] && probe_env+=(STUB_LOG="$STUB_LOG")
    case "$cli" in
      claude)
        if out=$("${probe_env[@]}" \
                 claude --model "$model" --print "reply ok" 2>&1 </dev/null) \
           && printf '%s' "$out" | grep -qi ok; then
          printf '%-12s %-10s %-12s OK\n' "$role" "$cli" "$model"
        else
          printf '%-12s %-10s %-12s UNAVAILABLE: %s\n' "$role" "$cli" "$model" \
            "$(printf '%s' "$out" | tail -1 | cut -c1-120)"
        fi
        ;;
      zai)
        if out=$("${probe_env[@]}" \
                 bash -c '. "$1" && exec claude --model "$2" --print "reply ok"' \
                 _ "$zai_env" "$model" 2>&1 </dev/null) \
           && printf '%s' "$out" | grep -qi ok; then
          printf '%-12s %-10s %-12s OK\n' "$role" "$cli" "$model"
        else
          printf '%-12s %-10s %-12s UNAVAILABLE: %s\n' "$role" "$cli" "$model" \
            "$(printf '%s' "$out" | tail -1 | cut -c1-120)"
        fi
        ;;
      codex)
        printf '%-12s %-10s %-12s not probed (codex has no cheap model check; models verified at first use)\n' "$role" "$cli" "$model"
        ;;
    esac
  done <<EOF
$(printf '%s' "$confout" | tail -n +2)
EOF
}

cmd_kill() { # $1 --config value ('' = the running team, else the default config)
  local root confout prefix sess mailbox recorded
  root="$(team_root)" || exit $?
  mailbox="$(git_common_dir "$root")/ai-team" || exit $?
  follow_team --kill "$root" "$mailbox" "$1"
  sess="$ACTIVE_SESSION"
  if [ -z "$sess" ]; then
    # nothing runs: name the session this config would have started
    confout="$(team_confout "$root")" || exit $?
    prefix="$(printf '%s' "$confout" | head -1 | cut -d "$TSV_SEP" -f1)"
    sess="$(session_name "$root" "$prefix")"
  fi
  tmux kill-session -t "=$sess" 2>/dev/null && say "killed $sess" || say "no session $sess"
  # drop the launch record unless its session is, against all odds, still there
  recorded="$(team_get "$mailbox" SESSION)"
  [ -n "$recorded" ] && [ -n "$(session_created "$recorded")" ] || rm -f "$mailbox/active"
  say "worktrees and branches are left in place (inspect .ai-team-worktrees/)"
}

# ---------- main -----------------------------------------------------------------

# Mode and flags may come in any order. Everything is parsed and checked
# before any mode runs, so a mistyped command line has no side effects.
MODE="" NO_ATTACH=0 CONFIG="" CONFIG_GIVEN=0 WORKERS=0

pick_mode() {
  [ -z "$MODE" ] || [ "$MODE" = "$1" ] || die "choose one mode: '$MODE' and '$1' cannot be combined"
  MODE="$1"
}

while [ $# -gt 0 ]; do
  case "$1" in
    init|up|--verify|--check-models|--kill) pick_mode "$1" ;;
    --no-attach) NO_ATTACH=1 ;;
    --workers) WORKERS=1 ;;
    --config|--config=*)
      [ "$CONFIG_GIVEN" = 0 ] || die "--config given more than once"
      if [ "$1" = "--config" ]; then
        [ $# -ge 2 ] || die "--config requires a file path (e.g. --config ai-team.claude.conf)"
        shift
        CONFIG="$1"
      else
        CONFIG="${1#--config=}"
      fi
      case "$CONFIG" in
        ""|-*) die "--config requires a file path, got '$CONFIG' (e.g. --config ai-team.claude.conf)" ;;
      esac
      CONFIG_GIVEN=1
      ;;
    -h|--help) usage; exit 0 ;;
    *) usage; die "unknown argument: $1" ;;
  esac
  shift
done

MODE="${MODE:-up}"
[ "$NO_ATTACH" = 0 ] || [ "$MODE" = up ] \
  || die "--no-attach applies to up only, not to $MODE"
[ "$WORKERS" = 0 ] || [ "$MODE" = up ] \
  || die "--workers applies to up only, not to $MODE (--verify and --kill follow the running team)"
[ "$CONFIG_GIVEN" = 0 ] || [ "$MODE" != init ] \
  || die "--config does not apply to init, which reads no config. Pass it to up, --verify, --check-models, or --kill"

case "$MODE" in
  init)           cmd_init ;;
  up)             cmd_up "$((1 - NO_ATTACH))" "$CONFIG" "$WORKERS" ;;
  --verify)       cmd_verify "$CONFIG" ;;
  --check-models) cmd_check_models "$CONFIG" ;;
  --kill)         cmd_kill "$CONFIG" ;;
esac
